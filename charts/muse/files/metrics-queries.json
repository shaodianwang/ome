{
  "_comment": "Curated Grafana Cloud Prometheus catalog queried through Query Gateway routing 2. Every selector is restricted by the configured cluster identity and MUSE's exact cached deployment pod allowlist. User-facing traffic prefers the SMG router when present, then falls back to SGLang or vLLM engine metrics. Range queries use a 60-second minimum step; the selected dashboard range may request a coarser cadence. Queries remain deployment-only to bound cardinality.",
  "queries": [
    {
      "id": "request_rate",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(smg_router_requests_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(sglang:e2e_request_latency_seconds_count{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(vllm:e2e_request_latency_seconds_count{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "error_rate",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(smg_http_responses_total{cluster=\"{{cluster_id}}\",status_code=~\"5..\"{{pod_matcher}}}[5m])) or sum(rate(sglang:num_aborted_requests_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(vllm:request_success_total{cluster=\"{{cluster_id}}\",finished_reason=~\"abort|error\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "latency_p99",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.99, sum by (le) (rate(smg_router_request_duration_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (le) (rate(sglang:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "latency_p50",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.50, sum by (le) (rate(smg_router_request_duration_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.50, sum by (le) (rate(sglang:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "ttft",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.99, sum by (le) (rate(sglang:time_to_first_token_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "tpot",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.99, sum by (le) (rate(sglang:inter_token_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "queue_time",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.99, sum by (le) (rate(sglang:queue_time_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (le) (rate(vllm:request_queue_time_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "throughput_tokens",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(sglang:generation_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(vllm:generation_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "input_tokens",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(sglang:prompt_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(vllm:prompt_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "running_reqs",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(smg_worker_requests_active{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or sum(sglang:num_running_reqs{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or sum(vllm:num_requests_running{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "queue_reqs",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(sglang:num_queue_reqs{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or sum(vllm:num_requests_waiting{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "kv_cache_usage",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "avg(sglang:token_usage{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or avg(vllm:kv_cache_usage_perc{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "prefix_cache_hit",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(sglang:cached_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) / clamp_min(sum(rate(sglang:prompt_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])), 1) or sum(rate(vllm:prefix_cache_hits_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) / clamp_min(sum(rate(vllm:prefix_cache_queries_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])), 1)",
      "scopes": ["deployment"]
    },
    {
      "id": "preemptions",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(vllm:num_preemptions_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum(rate(sglang:num_retracted_requests_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "kv_transfer_latency",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "histogram_quantile(0.99, sum by (le) (rate(sglang:kv_transfer_latency_ms_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) / 1000",
      "scopes": ["deployment"]
    },
    {
      "id": "prefill_queue",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum({__name__=~\"sglang:num_prefill_(bootstrap|inflight)_queue_reqs\",cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "decode_queue",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum({__name__=~\"sglang:num_decode_(prealloc|transfer)_queue_reqs\",cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "pd_transfer_fail",
      "kind": "range",
      "window": 21600,
      "step": 60,
      "promql": "sum(rate(sglang:num_transfer_failed_reqs_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) + sum(rate(sglang:num_bootstrap_failed_reqs_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_request_rate",
      "kind": "instant",
      "promql": "sum by (pod) (rate(sglang:e2e_request_latency_seconds_count{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum by (pod) (rate(vllm:e2e_request_latency_seconds_count{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_throughput_tokens",
      "kind": "instant",
      "promql": "sum by (pod) (rate(sglang:generation_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])) or sum by (pod) (rate(vllm:generation_tokens_total{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_latency_p99",
      "kind": "instant",
      "promql": "histogram_quantile(0.99, sum by (pod, le) (rate(sglang:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (pod, le) (rate(vllm:e2e_request_latency_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_ttft",
      "kind": "instant",
      "promql": "histogram_quantile(0.99, sum by (pod, le) (rate(sglang:time_to_first_token_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m]))) or histogram_quantile(0.99, sum by (pod, le) (rate(vllm:time_to_first_token_seconds_bucket{cluster=\"{{cluster_id}}\"{{pod_matcher}}}[5m])))",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_running_reqs",
      "kind": "instant",
      "promql": "sum by (pod) (sglang:num_running_reqs{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or sum by (pod) (vllm:num_requests_running{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_queue_reqs",
      "kind": "instant",
      "promql": "sum by (pod) (sglang:num_queue_reqs{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or sum by (pod) (vllm:num_requests_waiting{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    },
    {
      "id": "replica_kv_cache_usage",
      "kind": "instant",
      "promql": "avg by (pod) (sglang:token_usage{cluster=\"{{cluster_id}}\"{{pod_matcher}}}) or avg by (pod) (vllm:kv_cache_usage_perc{cluster=\"{{cluster_id}}\"{{pod_matcher}}})",
      "scopes": ["deployment"]
    }
  ]
}
