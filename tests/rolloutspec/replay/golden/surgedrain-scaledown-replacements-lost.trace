tick=1 event Normal RecreateUpdateStarted OMENative component=engine instance=2 surge to revision svc-a-engine-6f8b1e6c (newOrdinal=1)
tick=1 pod create name=svc-a-engine-2-default-1 revision=6f8b1e6c incarnation=1 ordinal=1
