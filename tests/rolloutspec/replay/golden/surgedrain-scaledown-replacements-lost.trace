tick=1 pass result=after:5s
tick=2 note every replacement is serving and in rotation, so every step advances to the drain
tick=2 apply pod.ready[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=2 apply endpoint.rotationIn[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=2 apply pod.ready[target] pod=svc-a-engine-1-default-1 now=t+0s
tick=2 apply endpoint.rotationIn[target] pod=svc-a-engine-1-default-1 now=t+0s
tick=2 apply pod.ready[target] pod=svc-a-engine-2-default-1 now=t+0s
tick=2 apply endpoint.rotationIn[target] pod=svc-a-engine-2-default-1 now=t+0s
tick=2 row=0 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-0-default-1 serving=absent→True
tick=2 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=SurgeDrain target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-1 serving=absent→True
tick=2 row=1 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=SurgeDrain target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 row=2 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-2-default-1 serving=absent→True
tick=2 row=2 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#3{type=Update step=SurgeDrain target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pod status-patch name=svc-a-engine-2-default-0 serving=True→False
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the replica count drops to one as the first retired index loses its replacement; both retired indices are stamped Deleting and nothing is recreated
tick=3 apply spec.replicasDown replicas=1 generation=2 now=t+0s
tick=3 apply pod.deleted[target] pod=svc-a-engine-1-default-1 now=t+0s
tick=3 row=2 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#4{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#5{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pass result=requeue
tick=4 note the second retired index loses its replacement and the same count is re-applied; the wave owns both rows and a missing pod only brings it closer to done
tick=4 apply pod.deleted[target] pod=svc-a-engine-2-default-1 now=t+0s
tick=4 apply spec.replicasDown replicas=1 generation=3 now=t+0s
tick=4 row=2 write no-op precondition=no-change
tick=4 row=1 write no-op precondition=no-change
tick=4 pass result=after:30s
tick=5 note both retired sources leave rotation, which is the drain the deletes wait on
tick=5 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=5 apply endpoint.rotationOut[source] pod=svc-a-engine-2-default-0 now=t+0s
tick=5 row=2 write no-op precondition=no-change
tick=5 row=1 write no-op precondition=no-change
tick=5 pod delete name=svc-a-engine-2-default-0 grace=default uidPrecondition=set
tick=5 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=5 pass result=after:30s
tick=6 note both retired sources are gone, so their rows are removed
tick=6 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=6 apply pod.deleted[source] pod=svc-a-engine-2-default-0 now=t+0s
tick=6 row=2 write no-op precondition=no-change
tick=6 row=1 write no-op precondition=no-change
tick=6 row=2 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#4{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=6 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#5{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=6 pass result=requeue
