tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the wedged pod is evicted under memory pressure; an evicted pod is terminal, so the set has no live pod left and the restart pass closes the spent operation without writing a phase
tick=4 apply pod.evicted pod=svc-a-engine-0-default-0 reason=Evicted now=t+2m0s
tick=4 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=nil lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=4 event Normal RepairClosed OMENative component=engine instance=0 repair parked after pod svc-a-engine-0-default-0 container main stuck (CrashLoopBackOff) closed: no live pod left to resume or rebuild; the Create pass rebuilds the Instance as a fresh start
tick=4 pass result=after:5s
tick=5 note the evicted pod is re-observed in its terminal phase on a Failed row with no operation, so its recycle frees the name under a fresh Create
tick=5 apply pod.phaseTerminal[Failed] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=5 hold cleared
tick=5 row=0 write incarnation=2 phase=Creating runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#2{type=Create step=CreatePods target=svc-a-engine-882059bb started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=5 row=0 write incarnation=2 phase=Creating runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#2{type=Create step=CreatePods target=svc-a-engine-882059bb retryCount=1 started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=Failed container=main exitCode=1} precondition=ok
tick=5 pod delete name=svc-a-engine-0-default-0 grace=default
tick=5 event Warning TerminalPodRecycled OMENative component=engine instance=0 deleted terminal pod(s) svc-a-engine-0-default-0 (Failed/Evicted) for recreate (Create recycle 1)
tick=5 pass result=after:5s
tick=6 note the recycled pod is gone, so the fresh start rebuilds the index
