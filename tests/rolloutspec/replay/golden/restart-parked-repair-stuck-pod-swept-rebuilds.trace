tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the wedged pod is bound and then deleted by another hand; a pod on its way out is live until it is gone, so the close waits
tick=4 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-1 now=t+2m0s
tick=4 apply pod.terminating[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the pod's kubelet stops acknowledging the deletion, so the object stays behind with no finalizer on it
tick=5 apply pod.stuckTerminating pod=svc-a-engine-0-default-0 deletionDeadline=t+2m0s now=t+2m0s
tick=5 hold cleared
tick=5 pass result=after:5s
tick=6 note the overdue clock lands on a pod whose node is gone, so the sweep force-deletes it ahead of the verb passes; the restart pass reads no live pod left and closes the spent repair, and the Create pass rebuilds the row as a fresh start in the same pass
tick=6 apply timer.forceDelete[overdueSlack] to=t+3m1s now=t+3m1s
tick=6 pod delete name=svc-a-engine-0-default-0 grace=0 uidPrecondition=set
tick=6 event Warning PodForceDeleted OMENative component=engine instance=0: force-deleted stuck-Terminating pod svc-a-engine-0-default-0 on node node-1 (evidence=node-gone, 1m1s past the pod's own deletion deadline)
tick=6 hold cleared
