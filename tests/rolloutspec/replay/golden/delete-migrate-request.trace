tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the operator asks the draining Instance off its node; the request is recorded and nothing drives it while the wave runs
tick=2 apply spec.migrateRequest uuid=uid#3 instance=1 fromNode=node-1 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 pass result=after:30s
tick=3 note the retired pod leaves rotation, so the wave issues the graceful delete
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 row=1 write no-op precondition=no-change
tick=3 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=3 pass result=after:30s
tick=4 note the pod is gone and a second request lands on the pass that removes the row, which ends at the removal commit with both records still waiting
tick=4 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 apply spec.migrateRequest uuid=uid#4 instance=1 fromNode=node-1 now=t+0s
tick=4 row=1 write no-op precondition=no-change
tick=4 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=4 pass result=requeue
tick=5 note a third request lands after the row is gone; the migrate pass now runs and fails the first record for want of a source Instance
tick=5 apply spec.migrateRequest uuid=uid#5 instance=1 fromNode=node-1 now=t+0s
tick=5 migration uuid=uid#3 write phase=Accepted→Failed message=nil→source InstanceStatus missing completedAt=nil→t+0s
tick=5 event Warning MigrationRequestRejected OMENative migration uuid=uid#3 rejected: source InstanceStatus missing
tick=5 pass result=requeue
tick=6 note the next pass fails the second record the same way
tick=6 migration uuid=uid#4 write phase=Accepted→Failed message=nil→source InstanceStatus missing completedAt=nil→t+0s
tick=6 event Warning MigrationRequestRejected OMENative migration uuid=uid#4 rejected: source InstanceStatus missing
tick=6 pass result=requeue
tick=7 note and the third, so no request aimed at the retired index is left Accepted
tick=7 migration uuid=uid#5 write phase=Accepted→Failed message=nil→source InstanceStatus missing completedAt=nil→t+0s
tick=7 event Warning MigrationRequestRejected OMENative migration uuid=uid#5 rejected: source InstanceStatus missing
tick=7 pass result=requeue
