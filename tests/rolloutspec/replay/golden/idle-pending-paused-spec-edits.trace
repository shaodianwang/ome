tick=1 note the row is Pending under a pause with its pod still forming, and the Create pass is parked
tick=1 pass result=none
tick=2 note the update strategy changes, and no operation owns this row for a mode to be re-resolved against
tick=2 apply spec.strategy strategy=RecreatePod generation=1 now=t+0s
tick=2 pass result=none
tick=3 note the replica count climbs, which plans a fresh index and leaves this row to the Create pass
tick=3 apply spec.replicasUp replicas=2 generation=2 now=t+0s
tick=3 pass result=none
tick=4 note the restart policy changes, and a row with no operation has nothing to re-arm from it
tick=4 apply spec.policyTuning[restartPolicy] restartPolicy=RecreateInstanceOnPodRestart generation=3 now=t+0s
tick=4 pass result=none
tick=5 note the roll is pinned to the revision the row records, and the update trigger declines below Ready
tick=5 apply spec.rollbackTarget[set] rollbackTo=registry.example.com/runtime:v1 generation=4 now=t+0s
tick=5 pass result=none
tick=6 note the pin is released again
tick=6 apply spec.rollbackTarget[clear] rollbackTo=nil generation=5 now=t+0s
tick=6 pass result=none
tick=7 note the operator asks the Pending Instance to migrate, and a row that is not steady Ready is never accepted as a source
tick=7 apply spec.migrateRequest uuid=uid#2 instance=0 fromNode=node-0 now=t+0s
tick=7 pass result=none
tick=8 note the row is still Pending under the pause
tick=8 pass result=none
