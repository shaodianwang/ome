tick=5 pass result=none
tick=6 note the replacement reports Ready; the row stays Failed on its running revision and the source alone serves
tick=6 apply pod.ready[target] pod=svc-a-engine-0-default-1 now=t+1m1s
tick=6 hold gate=Held target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c held after 1 failed attempt(s): ImagePullBackOff
tick=6 pass result=none
