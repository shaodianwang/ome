tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod is deleted out from under the Instance, so the repair opens a Restart and rebuilds it
tick=2 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 row=0 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod count 0 below desired 1 (incarnation=2)
tick=2 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=2 ordinal=0
tick=2 pass result=after:5s
tick=3 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=3 apply clock.advance by=2m0s now=t+2m0s
tick=3 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the operator pauses; the repair's exits hold under a plain pause and the wedged set gives them nothing to do
tick=4 apply spec.pauseTrue paused=true freeze=false generation=1 now=t+2m0s
tick=4 pass result=none
tick=5 note the pause becomes a freeze, which suspends the restart pass
tick=5 apply spec.pauseFreeze paused=true freeze=true generation=2 now=t+2m0s
tick=5 pass result=none
tick=6 note the pod reports ContainersReady under the freeze; only the status-only truth pass runs, so the resume waits
tick=6 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=6 pass result=none
tick=7 note the freeze is cleared; the un-parked restart pass writes the gate the resume starts with and the row stays Failed until the pod is PodReady
tick=7 apply spec.unpause paused=false freeze=false generation=3 now=t+2m0s
tick=7 pod status-patch name=svc-a-engine-0-default-0 serving=absent→True
tick=7 pass result=after:5s
tick=8 note the kubelet folds the gate into PodReady and the resume promotes the row
tick=8 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=8 row=0 write incarnation=2 phase=Ready runningRevision=svc-a-engine-882059bb readySince=t+2m0s op=nil lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=8 event Normal RestartCompleted OMENative component=engine instance=0 restart complete (incarnation=2)
tick=8 hold cleared
tick=8 row=0 write no-op precondition=no-change
tick=8 event Normal InstanceReady OMENative component=engine instance=0 is Ready (1 pod(s) serving)
tick=8 pass result=none
