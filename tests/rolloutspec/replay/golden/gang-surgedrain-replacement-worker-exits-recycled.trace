tick=4 note the replacement worker is deleted by hand with a grace period and its container exits cleanly, so the pod reads Succeeded while it is being removed; the recycle takes the dead member and the attempt counts the recycle
tick=4 apply pod.terminating[target] pod=svc-a-engine-2-worker-0 now=t+0s
tick=4 apply pod.phaseTerminal[Succeeded] pod=svc-a-engine-2-worker-0 now=t+0s
