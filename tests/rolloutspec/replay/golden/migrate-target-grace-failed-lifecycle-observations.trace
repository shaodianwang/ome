tick=4 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge waiting=Unschedulable surgeIndex=0 started=t+0s lastProgressAt=t+0s deadline=nil} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable} precondition=ok
tick=5 note the hold outlasts the configured grace, so the escalation stamps the surge row Failed with its Migrate pin kept while the source keeps serving under its own pin
tick=5 apply clock.advance by=11m0s now=t+11m0s
tick=5 row=1 write no-op precondition=no-change
tick=5 row=0 write no-op precondition=no-change
tick=5 row=1 write no-op precondition=no-change
