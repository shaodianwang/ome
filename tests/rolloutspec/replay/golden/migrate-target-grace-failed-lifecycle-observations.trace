tick=5 warn instanceFailed index=1 pod=svc-a-engine-1-default-0 reason=Unschedulable
tick=5 pass result=after:5s
tick=6 note the controller restarts, and the pin and the record are durable, so the next manager re-reads both and drives nothing
tick=6 apply ctrl.crash expectations=dropped now=t+11m0s
tick=6 pass result=after:5s
tick=7 note the surge pod is bound and a container waits with DeadlineExceeded, which is outside the terminal waiting set and is no early-failure evidence
tick=7 apply pod.scheduled[target] pod=svc-a-engine-1-default-0 node=node-1 now=t+11m0s
tick=7 apply pod.waiting[DeadlineExceeded] pod=svc-a-engine-1-default-0 reason=DeadlineExceeded now=t+11m0s
tick=7 pass result=after:5s
tick=8 note the surge pod's kubelet stops reporting it, which routes the name to the force-delete sweep rather than to any clock on this row
tick=8 apply pod.phaseTerminal[Unknown] pod=svc-a-engine-1-default-0 now=t+11m0s
tick=8 pass result=after:5s
tick=9 note the node under the source is gone, which reaches the pair only through its pods and the sweep
tick=9 apply pod.nodeLost[NodeGone] pod=svc-a-engine-0-default-0 node=node-0 evidence=gone now=t+11m0s
tick=9 pass result=after:5s
tick=10 note something else deletes the surge pod, and a pod on its way out is live until it is gone
tick=10 apply pod.terminating[target] pod=svc-a-engine-1-default-0 now=t+11m0s
tick=10 pass result=after:5s
tick=11 note the kubelet behind the surge pod stops acknowledging the deletion, and with no force-delete policy the sweep leaves it where it is
tick=11 apply pod.stuckTerminating pod=svc-a-engine-1-default-0 deletionDeadline=t+11m0s now=t+11m0s
tick=11 pass result=after:5s
tick=12 note the record's deadline elapses, so the expiry clears the pin from the Failed surge row, closes the record and restores the source to Ready on its running revision
tick=12 apply timer.migrationDeadline to=t+30m1s now=t+30m1s
tick=12 row=1 write incarnation=1 phase=Failed runningRevision=nil readySince=nil op=nil lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=12 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-882059bb readySince=t+0s op=nil precondition=ok
tick=12 migration uuid=uid#2 write phase=SurgePending→Failed message=surge allocated; waiting for surge pods→deadline exceeded in phase SurgePending: surge pods never became ready completedAt=nil→t+30m1s
tick=12 event Warning MigrationExpired OMENative migration uuid=uid#2 expired: deadline exceeded in phase SurgePending: surge pods never became ready; tearing down surge instance=1
tick=12 pass result=requeue
tick=13 note the unpinned index is beyond the desired set, so the scale-down pipeline commits Phase Deleting on it
tick=13 row=1 write incarnation=1 phase=Deleting runningRevision=nil readySince=nil op=op#4{type=Delete step=Drain started=t+30m1s lastProgressAt=t+30m1s deadline=t+1h0m1s} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=13 pass result=requeue
tick=14 note the drain finds nothing routed on the retired index and skips a pod already on its way out, so nothing is issued and the row waits for it to be gone
tick=14 row=1 write no-op precondition=no-change
tick=14 pass result=none
