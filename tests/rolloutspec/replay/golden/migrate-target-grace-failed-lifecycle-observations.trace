tick=3 pod create name=svc-a-engine-1-default-0 revision=882059bb incarnation=1 ordinal=0
tick=3 pass result=after:5s
tick=4 note the scheduler finds the surge no node off node-0, so the scheduler hold is recorded on the surge row and both pair deadlines park
tick=4 apply pod.unschedulable[target] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge waiting=Unschedulable surgeIndex=0 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable} precondition=ok
