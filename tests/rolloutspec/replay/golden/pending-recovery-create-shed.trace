tick=1 pod create-rejected name=svc-a-engine-0-default-0 rejection=api.throttled[TooManyRequests]
tick=1 pass result=after:30s
tick=2 note the server accepts the create on the next pass
tick=2 apply clock.advance by=30s now=t+30s
tick=2 hold cleared
tick=2 row=0 write no-op precondition=no-change
tick=2 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=1 ordinal=0
tick=2 pass result=after:5s
