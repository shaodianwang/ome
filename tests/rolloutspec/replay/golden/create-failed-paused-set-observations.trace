tick=6 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=6 pass result=none
tick=7 note the worker's pull wedges and the stuck-pod grace elapses on it; the fast escalator skips a row already stamped Failed
tick=7 apply pod.waiting[ImagePullBackOff] pod=svc-a-engine-0-worker-0 reason=ImagePullBackOff now=t+0s
tick=7 apply timer.stuckPodGrace to=t+1m1s now=t+1m1s
tick=7 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=7 pass result=none
tick=8 note the worker's kubelet stops reporting, so its phase reads Unknown; such a pod is neither terminal nor lost, and the name is freed only by the force-delete sweep on proven node death
tick=8 apply pod.phaseTerminal[Unknown] pod=svc-a-engine-0-worker-0 now=t+1m1s
tick=8 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=8 pass result=none
tick=9 note the worker reappears under a new UID and the leader's node is removed; identity is re-read from the live list and node loss reaches the row only through its pods
tick=9 apply pod.uidRotated pod=svc-a-engine-0-worker-0 uid=uid#2→uid#3 now=t+1m1s
tick=9 apply pod.nodeLost[NodeGone] pod=svc-a-engine-0-leader-0 node=node-0 evidence=gone now=t+1m1s
tick=9 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=9 pass result=none
tick=10 note a queue admission gates the worker; the deadline parking step applies to a transient phase only
tick=10 apply pod.schedulingGated pod=svc-a-engine-0-worker-0 now=t+1m1s
tick=10 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=10 pass result=none
tick=11 note the gate is removed; the deadline reconciler restarts a parked clock only for a transient phase
tick=11 apply pod.admitted pod=svc-a-engine-0-worker-0 now=t+1m1s
tick=11 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=11 pass result=none
tick=12 note the worker is deleted by someone else and holds its name on its way out; the Create pass reads nothing missing
tick=12 apply pod.terminating[source] pod=svc-a-engine-0-worker-0 now=t+1m1s
tick=12 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=12 pass result=none
tick=13 note two minutes pass, longer than the availability window and the stuck-pod grace, while the leader runs without readiness; no clock runs on a Failed row and no promote waits on the set
tick=13 apply clock.advance by=2m0s now=t+3m1s
tick=13 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=13 pass result=none
tick=14 note the kept operation's deadline elapses; the escalation pass skips a Failed row
tick=14 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=14 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=14 pass result=none
tick=15 note the cache lags a tick behind; every mutation out of Failed re-reads the row, and under the pause none is attempted
tick=15 apply ctrl.staleRead cache=end-of-tick-14 now=t+30m1s
tick=15 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=15 pass result=none
tick=16 note the controller restarts; the kept operation and the recorded verdict are persisted, so the next manager reads the same resting row
tick=16 apply ctrl.crash expectations=dropped now=t+30m1s
