tick=2 pass result=after:5s
tick=3 note the Component is paused; the row rests, as it would without the pause
tick=3 apply spec.pauseTrue paused=true freeze=false generation=1 now=t+0s
tick=3 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=3 pass result=none
tick=4 note both members are bound; binding is observation only
tick=4 apply pod.scheduled[source] pod=svc-a-engine-0-leader-0 node=node-0 now=t+0s
tick=4 apply pod.scheduled[source] pod=svc-a-engine-0-worker-0 node=node-0 now=t+0s
tick=4 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=4 pass result=none
tick=5 note the leader alone reports ContainersReady and PodReady, enters the rotation and has its serving gate written by another writer; nothing adopts or promotes members under a group another controller owns, so nothing is written
tick=5 apply pod.containersReady[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=5 apply pod.ready[source] pod=svc-a-engine-0-leader-0 now=t+0s
