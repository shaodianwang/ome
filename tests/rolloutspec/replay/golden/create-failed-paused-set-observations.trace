tick=5 apply pod.servingOn[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=5 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=5 pass result=none
tick=6 note the leader's gate is withdrawn, it leaves the rotation, drops out of readiness and its runner restarts; restart evidence is read only on a Ready row
tick=6 apply pod.servingOff[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=6 apply endpoint.rotationOut[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=6 apply pod.containersNotReady[source] pod=svc-a-engine-0-leader-0 now=t+0s
