tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the operator asks the Instance off node-0, and the migrate pass claims index 1 as the surge at the source's running revision and establishes the pair
tick=2 apply spec.migrateRequest uuid=uid#2 instance=0 fromNode=node-0 now=t+0s
tick=2 condition type=MigrationPolicyUnconfigured status=False reason=MigrationCapacityConfigured message=Migration capacity policy is configured
tick=2 migration uuid=uid#2 write phase=Accepted→SurgePending surge=nil→1 message=nil→surge allocated; waiting for surge pods allocatedAt=nil→t+0s
tick=2 row=0 write incarnation=1 phase=Migrating runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Migrate step=CreateSurge surgeIndex=1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#2{type=Migrate step=CreateSurge surgeIndex=0 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Normal MigrationRequestAccepted OMENative component=engine instance=0 migration accepted (uuid=uid#2, source-node=node-0, surge-index=1)
tick=2 pod create name=svc-a-engine-1-default-0 revision=882059bb incarnation=1 ordinal=0
tick=2 pass result=after:5s
tick=3 note the template moves and the replica count climbs in the same observation; the claimed index stays the migration's own and the source, being migrate-owned, is not rolled
tick=3 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=3 apply spec.replicasUp replicas=2 generation=2 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=1 write no-op precondition=no-change
tick=3 pass result=after:5s
