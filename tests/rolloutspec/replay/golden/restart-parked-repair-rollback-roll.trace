tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod template changes, so the roll drains the pod for a recreate
tick=2 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=2 gate consult strategy=RecreatePod surge=0 unavail=0 verdict=allow
tick=2 row=0 write incarnation=2 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Normal RecreateUpdateStarted OMENative component=engine instance=0 recreate (revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c, incarnation=2)
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the pod leaves rotation and is gone, so the rebuild lands at the new revision
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=3 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 pod create name=svc-a-engine-0-default-0 revision=6f8b1e6c incarnation=2 ordinal=0
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the rebuilt pod reports Ready and the Instance promotes onto the second revision
tick=4 apply pod.ready[target] pod=svc-a-engine-0-default-0 now=t+0s
tick=4 row=0 write no-op precondition=no-change
tick=4 pod status-patch name=svc-a-engine-0-default-0 serving=absent→True
tick=4 row=0 write incarnation=2 phase=Ready runningRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=nil precondition=ok
tick=4 event Normal RecreateUpdateCompleted OMENative component=engine instance=0 recreate to revision svc-a-engine-6f8b1e6c complete
tick=4 hold cleared
tick=4 pass result=requeue
tick=5 note the pod is deleted out from under the Instance, so the repair opens a Restart and rebuilds it
tick=5 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=5 row=0 write incarnation=3 phase=Restarting runningRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=5 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod count 0 below desired 1 (incarnation=3)
tick=5 pod create name=svc-a-engine-0-default-0 revision=6f8b1e6c incarnation=3 ordinal=0
tick=5 pass result=after:5s
tick=6 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=6 apply clock.advance by=2m0s now=t+2m0s
tick=6 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=6 row=0 write no-op precondition=no-change
tick=6 row=0 write incarnation=3 phase=Failed runningRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=6 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=6 pass result=after:5s
tick=7 note the operator pins the roll back to the first revision; the running revision is no longer the target, so the roll replaces the parked repair with a fresh recreate attempt and drains the wedged pod
tick=7 apply spec.rollbackTarget[set] rollbackTo=registry.example.com/runtime:v1 generation=2 now=t+2m0s
tick=7 row=0 write incarnation=4 phase=Updating runningRevision=svc-a-engine-6f8b1e6c targetRevision=svc-a-engine-882059bb readySince=t+0s op=op#3{type=Update step=Drain target=svc-a-engine-882059bb reason=revision svc-a-engine-6f8b1e6c -> svc-a-engine-882059bb strategy=RecreatePod started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=7 event Normal RecreateUpdateStarted OMENative component=engine instance=0 recreate (revision svc-a-engine-6f8b1e6c -> svc-a-engine-882059bb, incarnation=4)
tick=7 pod delete name=svc-a-engine-0-default-0 grace=default
tick=7 hold cleared
tick=7 pass result=after:5s
tick=8 note the pin is released and the wedged pod is gone; the row is the fresh attempt's, which retargets back to the rendered template and rebuilds
tick=8 apply spec.rollbackTarget[clear] rollbackTo=nil generation=3 now=t+2m0s
tick=8 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=8 row=0 write incarnation=5 phase=Updating runningRevision=svc-a-engine-6f8b1e6c targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#3{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-6f8b1e6c -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=8 pod create name=svc-a-engine-0-default-0 revision=6f8b1e6c incarnation=5 ordinal=0
tick=8 hold cleared
tick=8 pass result=after:5s
