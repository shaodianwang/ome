tick=1 note the demoted row sits under the pause with its pod present, and the Create pass is parked
tick=1 pass result=none
tick=2 note the pod is evicted under memory pressure; the pause parks the Create pass, so the dead occupant stands
tick=2 apply pod.evicted pod=svc-a-engine-0-default-0 reason=Evicted now=t+0s
tick=2 pass result=none
tick=3 note the pause clears, so the Create pass commits its attempt and recycles the dead occupant on the same pass
tick=3 apply spec.unpause paused=false freeze=false generation=1 now=t+0s
tick=3 hold cleared
tick=3 row=0 write incarnation=1 phase=Creating runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-882059bb started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 row=0 write incarnation=1 phase=Creating runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-882059bb retryCount=1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=Evicted message=The node was low on resource: memory.} precondition=ok
tick=3 pod delete name=svc-a-engine-0-default-0 grace=default
tick=3 event Warning TerminalPodRecycled OMENative component=engine instance=0 deleted terminal pod(s) svc-a-engine-0-default-0 (Failed/Evicted) for recreate (Create recycle 1)
tick=3 pass result=after:5s
tick=4 note the unpause is observed again as the evicted pod is gone; the attempt already committed recreates the pod
tick=4 apply spec.unpause paused=false freeze=false generation=2 now=t+0s
tick=4 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=4 hold cleared
tick=4 row=0 write no-op precondition=no-change
tick=4 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=1 ordinal=0
tick=4 pass result=after:5s
tick=5 note the recreated pod reports Ready and enters rotation, so the Instance promotes on its running revision
tick=5 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=5 apply endpoint.rotationIn[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=5 hold cleared
tick=5 pod status-patch name=svc-a-engine-0-default-0 serving=absent→True
tick=5 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-882059bb readySince=t+0s op=nil lastFailure={pod=svc-a-engine-0-default-0 reason=Evicted message=The node was low on resource: memory.} precondition=ok
