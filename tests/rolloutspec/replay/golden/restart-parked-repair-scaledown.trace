tick=1 note both Ready rows are steady on their serving pods
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 row=1 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the second Instance's pod is deleted out from under it, so the repair opens a Restart and rebuilds it
tick=2 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=2 row=1 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=1 restart triggered: pod count 0 below desired 1 (incarnation=2)
tick=2 pod create name=svc-a-engine-1-default-0 revision=882059bb incarnation=2 ordinal=0
tick=2 pass result=after:5s
tick=3 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=3 apply clock.advance by=2m0s now=t+2m0s
tick=3 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-1-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=3 row=1 write no-op precondition=no-change
tick=3 row=1 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=1 pod=svc-a-engine-1-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the replica count drops to one, so the parked repair's index leaves the plan and the wave stamps Deleting over the spent Restart
tick=4 apply spec.replicasDown replicas=1 generation=1 now=t+2m0s
tick=4 row=1 write incarnation=2 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#2{type=Delete step=Drain started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=4 pass result=requeue
tick=5 note the same count is re-applied; the wave owns the row and deletes the wedged pod
tick=5 apply spec.replicasDown replicas=1 generation=2 now=t+2m0s
tick=5 row=1 write no-op precondition=no-change
tick=5 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=5 pass result=after:30s
tick=6 note the retired pod is gone, so its row is removed
tick=6 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+2m0s
tick=6 row=1 write no-op precondition=no-change
tick=6 row=1 remove incarnation=2 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#2{type=Delete step=Drain started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=6 pass result=requeue
