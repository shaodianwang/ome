tick=8 note twenty seconds later the promoted runner restarts under the same pod; one restart is not a crash of the revision, so the ladder records nothing
tick=8 apply clock.advance by=20s now=t+20s
tick=8 apply pod.containerRestart pod=svc-a-engine-0-default-1 container=ome-container reason=Error now=t+20s
