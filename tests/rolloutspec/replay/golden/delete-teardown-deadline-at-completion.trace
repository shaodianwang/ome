tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the retired pod leaves rotation, so the wave deletes it
tick=2 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=2 pass result=after:30s
tick=3 note the owner was deleted and its teardown deadline has elapsed by the time the pass runs, which also finds the pod gone, the count raised and a migration requested; the release runs ahead of the wave, so nothing completes, rolls or moves and the owner goes with every row
tick=3 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 apply spec.replicasUp replicas=3 generation=2 now=t+0s
tick=3 apply spec.migrateRequest uuid=uid#3 instance=0 fromNode=node-0 now=t+0s
tick=3 apply spec.teardown[deleted] teardown=true now=t+0s
tick=3 apply timer.teardownDeadline to=t+10m1s now=t+10m1s
tick=3 event Warning TeardownDeadlineExceeded teardown deadline 10m exceeded (1 owned pod(s) observed; selector: parent="svc-a", component="engine"); releasing the teardown finalizer to background GC
tick=3 owner deleted rows=2
tick=3 pass result=none
tick=4 note a late pass finds no owner left to act on
tick=4 owner gone; nothing reconciles
tick=4 pass result=none
