tick=1 note the template changes, so the first gang claims the free index as its replacement and the other gang waits on the surge budget
tick=1 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=1 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=1 podgroup create name=svc-a-engine-0
tick=1 podgroup create name=svc-a-engine-1
tick=1 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=1 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-3363fef6 targetRevision=svc-a-engine-367ef4b7 readySince=t+0s op=op#1{type=Update step=Surge target=svc-a-engine-367ef4b7 strategy=SurgeThenDrain surgeIndex=2 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
