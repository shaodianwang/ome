tick=2 gate consult strategy=RecreatePod surge=0 unavail=0 verdict=allow
tick=2 row=0 write incarnation=2 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Normal RecreateUpdateStarted OMENative component=engine instance=0 recreate (revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c, incarnation=2)
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the pod leaves rotation and is deleted, so the roll recreates it at the new revision
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=3 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 pod create name=svc-a-engine-0-default-0 revision=6f8b1e6c incarnation=2 ordinal=0
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the rebuilt pod is still booting when the deadline elapses; the ladder counts the wave and the attempt is parked with the row Failed
tick=4 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=4 row=0 write no-op precondition=no-change
tick=4 hold cleared
tick=4 retryblock target=svc-a-engine-6f8b1e6c persist nil→{state=Backoff attempts=1 nextRetryAt=t+1h30m1s reason=DeadlineExceeded}
tick=4 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Parked target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c waiting=RetryBlock strategy=RecreatePod started=t+0s lastProgressAt=t+0s deadline=nil} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=4 warn instanceFailed index=0 pod=nil reason=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout: attempt disposed terminal (no workload-caused evidence, relocation unavailable) and counted on the revision's retry ladder
tick=4 pass result=after:5s
tick=5 note the rebuilt pod reports runtime-ready; the set carries no serving gate, so the row keeps Failed with the attempt parked and nothing promotes it
tick=5 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+30m1s
tick=5 hold gate=RetryBlock target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c in backoff after 1 failed attempt(s): DeadlineExceeded
tick=5 pass result=after:1h0m0s
tick=6 note the pod reports Ready; PodReady adds nothing the parked reading does not take from ContainersReady and the serving gate, and the ladder still counts one wave
tick=6 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+30m1s
tick=6 hold gate=RetryBlock target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c in backoff after 1 failed attempt(s): DeadlineExceeded
tick=6 pass result=after:1h0m0s
tick=7 note the block comes due; the gate admits and a fresh recreate attempt with a new incarnation replaces the parked one
tick=7 apply timer.retryAt to=t+1h30m2s now=t+1h30m2s
tick=7 row=0 write incarnation=3 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+1h30m2s lastProgressAt=t+1h30m2s deadline=t+2h0m2s} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout} precondition=ok
