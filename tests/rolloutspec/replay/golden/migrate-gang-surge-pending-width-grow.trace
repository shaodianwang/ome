tick=1 note the gang's PodGroup is announced before its first member, and the Create pass materializes both
tick=1 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=1 podgroup create name=svc-a-engine-0
tick=1 hold cleared
tick=1 row=0 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-3363fef6 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InstanceCreated OMENative component=engine instance=0 materialized; 2 pod(s) requested
tick=1 pod create name=svc-a-engine-0-leader-0 revision=3363fef6 incarnation=1 ordinal=0
tick=1 pod create name=svc-a-engine-0-worker-0 revision=3363fef6 incarnation=1 ordinal=0
tick=1 pass result=after:5s
tick=2 note both members are bound to node-0 and report Ready, and the leader enters rotation, so the Instance promotes as one
tick=2 apply pod.scheduled[source] pod=svc-a-engine-0-leader-0 node=node-0 now=t+0s
tick=2 apply pod.scheduled[source] pod=svc-a-engine-0-worker-0 node=node-0 now=t+0s
tick=2 apply pod.ready[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=2 apply pod.ready[source] pod=svc-a-engine-0-worker-0 now=t+0s
tick=2 apply endpoint.rotationIn[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=2 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=2 hold cleared
tick=2 pod status-patch name=svc-a-engine-0-leader-0 serving=absent→True
tick=2 pod status-patch name=svc-a-engine-0-worker-0 serving=absent→True
tick=2 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-3363fef6 readySince=t+0s op=nil precondition=ok
tick=2 event Normal InstanceReady OMENative component=engine instance=0 is Ready (2 pod(s) serving)
tick=2 pass result=none
tick=3 note the operator asks the Instance off node-0, and the migrate pass admits the request and establishes the pair
tick=3 apply spec.migrateRequest uuid=uid#3 instance=0 fromNode=node-0 now=t+0s
tick=3 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=3 condition type=MigrationPolicyUnconfigured status=False reason=MigrationCapacityConfigured message=Migration capacity policy is configured
tick=3 migration uuid=uid#3 write phase=Accepted→SurgePending surge=nil→1 message=nil→surge allocated; waiting for surge pods allocatedAt=nil→t+0s
tick=3 row=0 write incarnation=1 phase=Migrating runningRevision=svc-a-engine-3363fef6 readySince=t+0s op=op#2{type=Migrate step=CreateSurge surgeIndex=1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge surgeIndex=0 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 event Normal MigrationRequestAccepted OMENative component=engine instance=0 migration accepted (uuid=uid#3, source-node=node-0, surge-index=1)
tick=3 pass result=after:5s
tick=4 note the surge gang's PodGroup is announced before its first member, and both members are created
tick=4 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=4 podgroup create name=svc-a-engine-1
tick=4 row=0 write no-op precondition=no-change
tick=4 row=1 write no-op precondition=no-change
tick=4 pod create name=svc-a-engine-1-leader-0 revision=3363fef6 incarnation=1 ordinal=0
tick=4 pod create name=svc-a-engine-1-worker-0 revision=3363fef6 incarnation=1 ordinal=0
tick=4 pass result=after:5s
tick=5 note the gang is widened by one worker, so the drive widens the surge's desired pod set and creates the extra member, while the source keeps the pod set it already had
tick=5 apply spec.gangWidth[grow] workers=2 generation=1 now=t+0s
tick=5 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=5 podgroup update name=svc-a-engine-0
tick=5 podgroup update name=svc-a-engine-1
tick=5 row=0 write no-op precondition=no-change
tick=5 row=1 write no-op precondition=no-change
tick=5 pod create name=svc-a-engine-1-worker-1 revision=3363fef6 incarnation=1 ordinal=1
tick=5 pass result=after:5s
tick=6 note a tick with nothing changed finds the wider surge standing and waits on it
tick=6 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=6 row=0 write no-op precondition=no-change
tick=6 row=1 write no-op precondition=no-change
tick=6 pass result=after:5s
tick=7 note the record's deadline elapses, so the expiry clears both pins, closes the record and restores the source to Ready on its running revision
tick=7 apply timer.migrationDeadline to=t+30m1s now=t+30m1s
tick=7 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=7 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=nil precondition=ok
tick=7 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-3363fef6 readySince=t+0s op=nil precondition=ok
tick=7 migration uuid=uid#3 write phase=SurgePending→Failed message=surge allocated; waiting for surge pods→deadline exceeded in phase SurgePending: surge pods never became ready completedAt=nil→t+30m1s
tick=7 event Warning MigrationExpired OMENative migration uuid=uid#3 expired: deadline exceeded in phase SurgePending: surge pods never became ready; tearing down surge instance=1
tick=7 pass result=requeue
tick=8 note the unpinned surge index is beyond the desired set, so the scale-down pipeline commits Phase Deleting on it
tick=8 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=8 row=1 write incarnation=1 phase=Deleting runningRevision=nil readySince=nil op=op#4{type=Delete step=Drain started=t+30m1s lastProgressAt=t+30m1s deadline=t+1h0m1s} precondition=ok
tick=8 pass result=requeue
