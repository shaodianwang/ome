tick=1 note the gang's PodGroup is announced before its first member, and the Create pass materializes all three
tick=1 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=1 podgroup create name=svc-a-engine-0
tick=1 hold cleared
tick=1 row=0 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-3363fef6 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InstanceCreated OMENative component=engine instance=0 materialized; 3 pod(s) requested
tick=1 pod create name=svc-a-engine-0-leader-0 revision=3363fef6 incarnation=1 ordinal=0
tick=1 pod create name=svc-a-engine-0-worker-0 revision=3363fef6 incarnation=1 ordinal=0
tick=1 pod create name=svc-a-engine-0-worker-1 revision=3363fef6 incarnation=1 ordinal=1
tick=1 pass result=after:5s
tick=2 note the leader comes up and loses readiness again as a queue label, a longer timeout and a new requeue cadence land; the regression re-opens the wait inside the attempt, the pinned attempt and its stamped deadline are untouched, and only the requeue shows the edit
tick=2 apply pod.containersReady[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=2 apply pod.containersNotReady[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=2 apply spec.annotationOnly labels=[kueue.x-k8s.io/queue-name:queue-b] generation=1 now=t+0s
tick=2 apply spec.policyTuning[instanceReadyTimeout] instanceReadyTimeout=45m generation=2 now=t+0s
tick=2 apply config.changed[requeue] requeue={operation=7s gate=3s} now=t+0s
tick=2 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=2 podgroup update name=svc-a-engine-0
tick=2 hold cleared
tick=2 pass result=after:7s
tick=3 note the first worker reappears under a new UID and the second is deleted from outside; the pass addresses pods by name, so the rotated pod is adopted on the next list and the terminating pod still occupies its slot
tick=3 apply pod.uidRotated pod=svc-a-engine-0-worker-0 uid=uid#2→uid#4 now=t+0s
tick=3 apply pod.terminating[source] pod=svc-a-engine-0-worker-1 now=t+0s
tick=3 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=3 hold cleared
tick=3 pass result=after:7s
tick=4 note the terminating worker is gone, so its name is re-created inside the same attempt
tick=4 apply pod.deleted[source] pod=svc-a-engine-0-worker-1 now=t+0s
tick=4 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=4 hold cleared
tick=4 row=0 write no-op precondition=no-change
tick=4 pod create name=svc-a-engine-0-worker-1 revision=3363fef6 incarnation=1 ordinal=1
tick=4 pass result=after:7s
tick=5 note the width shrinks to one worker; the surplus ordinal's pod is deleted by no pass, so it stays and must still be ready before the promote
tick=5 apply spec.gangWidth[shrink] workers=1 generation=3 now=t+0s
tick=5 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=5 podgroup update name=svc-a-engine-0
tick=5 hold cleared
tick=5 pass result=after:7s
tick=6 note the leader and the first worker report Ready; the surplus worker is not, so the promote waits on it
tick=6 apply pod.ready[source] pod=svc-a-engine-0-leader-0 now=t+0s
tick=6 apply pod.ready[source] pod=svc-a-engine-0-worker-0 now=t+0s
tick=6 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=6 hold cleared
tick=6 pass result=after:7s
tick=7 note the surplus worker reports Ready too, so the whole live set clears the bar and the Instance promotes
tick=7 apply pod.ready[source] pod=svc-a-engine-0-worker-1 now=t+0s
tick=7 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=7 hold cleared
