tick=3 pod create name=svc-a-engine-0-default-1 revision=rev#2 incarnation=1 ordinal=1
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the replacement is serving and in rotation beside the source
tick=4 apply pod.ready[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=4 apply endpoint.rotationIn[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=4 row=0 write no-op precondition=no-change
tick=4 pod status-patch name=svc-a-engine-0-default-1 serving=absent→True
tick=4 row=0 write op#2.step=Surge→SurgeDrain precondition=ok
tick=4 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=4 pod delete name=svc-a-engine-0-default-0 grace=default
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the target is reverted to the revision the source still runs, with the replacement Ready but not yet promoted
tick=5 apply spec.revision image=registry.example.com/runtime:v1 generation=2 now=t+0s
tick=5 row=0 write no-op precondition=no-change
tick=5 row=0 write no-op precondition=no-change
tick=5 hold cleared
tick=5 pass result=after:5s
tick=6 note the source leaves rotation, so the drain has converged
tick=6 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=6 row=0 write no-op precondition=no-change
tick=6 row=0 write no-op precondition=no-change
tick=6 hold cleared
tick=6 pass result=after:5s
tick=7 note the drained source is gone and the cycle promotes onto the pinned revision, not the restored one
tick=7 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=7 row=0 write no-op precondition=no-change
tick=7 row=0 write phase=Updating→Ready runningRevision=rev#1→rev#2 targetRevision=rev#2→nil activeOrdinal=0→1 op=op#2→nil precondition=ok
tick=7 event Normal RecreateUpdateCompleted OMENative component=engine instance=0 surge to revision rev#2 complete (activeOrdinal=1)
tick=7 hold cleared
tick=7 pass result=requeue
tick=8 note the restored target now rolls from Ready, surging back
tick=8 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=8 row=0 write phase=Ready→Updating targetRevision=nil→rev#1 op=nil→op#2{type=Update step=Surge target=rev#1 strategy=SurgeThenDrain started=t+0s deadline=t+30m0s} precondition=ok
tick=8 event Normal RecreateUpdateStarted OMENative component=engine instance=0 surge to revision rev#1 (newOrdinal=0)
tick=8 pod create name=svc-a-engine-0-default-0 revision=rev#1 incarnation=1 ordinal=0
tick=8 hold cleared
tick=8 pass result=after:5s
tick=9 note the second replacement is serving beside the promoted pod
tick=9 apply pod.ready[target] pod=svc-a-engine-0-default-0 now=t+0s
tick=9 apply endpoint.rotationIn[target] pod=svc-a-engine-0-default-0 now=t+0s
tick=9 row=0 write no-op precondition=no-change
