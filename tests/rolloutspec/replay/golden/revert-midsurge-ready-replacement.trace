tick=2 event Normal InstanceReady OMENative component=engine instance=0 is Ready (1 pod(s) serving)
tick=2 pass result=none
tick=3 note the pod template changes, so the rollout surges a replacement
tick=3 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=3 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=3 row=0 write phase=Ready→Updating targetRevision=nil→rev#2 op=nil→op#2{type=Update step=Surge target=rev#2 strategy=SurgeThenDrain started=t+0s deadline=t+30m0s} precondition=ok
