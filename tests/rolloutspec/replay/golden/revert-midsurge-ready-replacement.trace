tick=9 row=0 write op#2.step=Surge→SurgeDrain precondition=ok
tick=9 pod status-patch name=svc-a-engine-0-default-1 serving=True→False
tick=9 pod delete name=svc-a-engine-0-default-1 grace=default
tick=9 hold cleared
tick=9 pass result=after:5s
