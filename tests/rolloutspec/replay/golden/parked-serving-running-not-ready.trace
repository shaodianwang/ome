tick=6 pass result=after:1h0m0s
tick=7 note the pod's readiness regresses while it keeps running; inside the grace the set still reads as the attempt's
tick=7 apply pod.containersNotReady[source] pod=svc-a-engine-0-default-0 now=t+30m1s
tick=7 hold gate=RetryBlock target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c in backoff after 1 failed attempt(s): DeadlineExceeded
tick=7 pass result=after:5s
tick=8 note the pod has been unready past the grace, so the set serves nothing and the row returns to Failed with the attempt kept
tick=8 apply clock.advance by=2m0s now=t+32m1s
tick=8 hold gate=RetryBlock target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c in backoff after 1 failed attempt(s): DeadlineExceeded
