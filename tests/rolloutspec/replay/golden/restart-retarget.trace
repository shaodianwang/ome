tick=2 pod delete name=svc-a-engine-0-default-0 grace=default
tick=2 pass result=after:5s
tick=3 note the template moves to a new revision while the repair is open; the repair is driven on and waits for the old pod to clear
tick=3 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 pass result=after:5s
tick=4 note the old pod is gone and the repair rebuilds the Instance from the running revision's stored template, under that revision's label
tick=4 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=4 row=0 write no-op precondition=no-change
tick=4 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=2 ordinal=0 image=registry.example.com/runtime:v1
tick=4 pass result=after:5s
tick=5 note the rebuilt pod reports Ready and enters rotation, and the repair promotes the row on the running revision
tick=5 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+0s
