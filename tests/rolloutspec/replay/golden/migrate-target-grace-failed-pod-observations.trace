tick=1 note the index is planned and no row exists, so the Create pass opens the attempt
tick=1 hold cleared
tick=1 row=0 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-8aa14b8b started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InstanceCreated OMENative component=engine instance=0 materialized; 1 pod(s) requested
tick=1 pod create name=svc-a-engine-0-default-0 revision=8aa14b8b incarnation=1 ordinal=0
tick=1 pass result=after:5s
tick=2 note the pod is bound, becomes Ready and enters rotation, so the row records a running revision on a known node
tick=2 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-0 now=t+0s
tick=2 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 apply endpoint.rotationIn[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 hold cleared
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=absent→True
tick=2 pass result=after:30s
tick=3 note the availability window elapses, so the Instance promotes on its running revision
tick=3 apply clock.advance by=1m0s now=t+1m0s
tick=3 hold cleared
tick=3 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-8aa14b8b readySince=t+1m0s op=nil precondition=ok
tick=3 event Normal InstanceReady OMENative component=engine instance=0 is Ready (1 pod(s) serving)
tick=3 pass result=none
tick=4 note a minute into steady Ready the operator asks the Instance off node-0, and the migrate pass admits the request and establishes the pair
tick=4 apply clock.advance by=1m0s now=t+2m0s
tick=4 apply spec.migrateRequest uuid=uid#2 instance=0 fromNode=node-0 now=t+2m0s
tick=4 condition type=MigrationPolicyUnconfigured status=False reason=MigrationCapacityConfigured message=Migration capacity policy is configured
tick=4 migration uuid=uid#2 write phase=Accepted→SurgePending surge=nil→1 message=nil→surge allocated; waiting for surge pods allocatedAt=nil→t+2m0s
tick=4 row=0 write incarnation=1 phase=Migrating runningRevision=svc-a-engine-8aa14b8b readySince=t+1m0s op=op#2{type=Migrate step=CreateSurge surgeIndex=1 started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} precondition=ok
tick=4 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge surgeIndex=0 started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} precondition=ok
tick=4 event Normal MigrationRequestAccepted OMENative component=engine instance=0 migration accepted (uuid=uid#2, source-node=node-0, surge-index=1)
tick=4 pod create name=svc-a-engine-1-default-0 revision=8aa14b8b incarnation=1 ordinal=0
tick=4 pass result=after:5s
tick=5 note the scheduler finds the surge no node off node-0, so the scheduler hold is recorded on the surge row and both pair deadlines park
tick=5 apply pod.unschedulable[target] pod=svc-a-engine-1-default-0 now=t+2m0s
tick=5 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge waiting=Unschedulable surgeIndex=0 started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable} precondition=ok
tick=5 row=0 write no-op precondition=no-change
tick=5 row=1 write no-op precondition=no-change
tick=5 pass result=after:5s
tick=5 row=0 write incarnation=1 phase=Migrating runningRevision=svc-a-engine-8aa14b8b readySince=t+1m0s op=op#2{type=Migrate step=CreateSurge surgeIndex=1 started=t+2m0s lastProgressAt=t+2m0s deadline=nil} precondition=ok
tick=5 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge waiting=Unschedulable surgeIndex=0 started=t+2m0s lastProgressAt=t+2m0s deadline=nil} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable} precondition=ok
tick=6 note the hold outlasts the configured grace, so the escalation stamps the surge row Failed with its Migrate pin kept while the source keeps serving under its own pin
tick=6 apply clock.advance by=11m0s now=t+13m0s
tick=6 row=1 write no-op precondition=no-change
tick=6 row=0 write no-op precondition=no-change
tick=6 row=1 write no-op precondition=no-change
tick=6 row=1 write incarnation=1 phase=Failed runningRevision=nil readySince=nil op=op#3{type=Migrate step=CreateSurge waiting=Unschedulable surgeIndex=0 started=t+2m0s lastProgressAt=t+2m0s deadline=nil} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=6 warn instanceFailed index=1 pod=svc-a-engine-1-default-0 reason=Unschedulable
tick=6 pass result=after:5s
tick=7 note a tick with nothing changed finds the record's deadline ahead, and no pass drives a pair whose surge reads Failed
tick=7 pass result=after:5s
tick=8 note the source's binding and container readiness are observed again, which gate no step of the migration
tick=8 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-0 now=t+13m0s
tick=8 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+13m0s
tick=8 pass result=after:5s
tick=9 note the surge pod finds a node after all, which nothing reads on a row the pair write cannot promote
tick=9 apply pod.scheduled[target] pod=svc-a-engine-1-default-0 node=node-1 now=t+13m0s
tick=9 pass result=after:5s
tick=10 note the surge pod reports ContainersReady, and no serving gate is written for a surge row that reads Failed
tick=10 apply pod.containersReady[target] pod=svc-a-engine-1-default-0 now=t+13m0s
tick=10 pass result=after:5s
tick=11 note the surge pod reports PodReady and its serving gate reads True, which feed a promote this row cannot take
tick=11 apply pod.ready[target] pod=svc-a-engine-1-default-0 now=t+13m0s
tick=11 apply pod.servingOn[target] pod=svc-a-engine-1-default-0 now=t+13m0s
tick=11 pass result=after:5s
tick=12 note the surge pod enters rotation, which feeds the availability gate of the same promote
tick=12 apply endpoint.rotationIn[target] pod=svc-a-engine-1-default-0 now=t+13m0s
tick=12 pass result=after:5s
tick=13 note a minute passes, longer than the minReadySeconds window, which guards a promote this row cannot take
tick=13 apply clock.advance by=1m0s now=t+14m0s
tick=13 pass result=after:5s
tick=14 note the surge pod leaves rotation and its serving gate reads False, which move counters and nothing on the pair
tick=14 apply endpoint.rotationOut[target] pod=svc-a-engine-1-default-0 now=t+14m0s
tick=14 apply pod.servingOff[target] pod=svc-a-engine-1-default-0 now=t+14m0s
tick=14 pass result=after:5s
tick=15 note the surge pod's containers stop being ready while it keeps running, which re-closes readiness gates nobody is reading
tick=15 apply pod.containersNotReady[target] pod=svc-a-engine-1-default-0 now=t+14m0s
tick=15 pass result=after:5s
tick=16 note two minutes on, longer than the stuck-pod grace, the surge pod still runs without readiness, and no clock on this row measures it
tick=16 apply clock.advance by=2m0s now=t+16m0s
tick=16 pass result=after:5s
tick=17 note the surge pod's runner restarts, which is evidence read against ReadySince and only on a Ready row
tick=17 apply pod.containerRestart pod=svc-a-engine-1-default-0 container=ome-container reason=Error now=t+16m0s
tick=17 pass result=after:5s
tick=18 note the record's deadline elapses, so the expiry clears the pin from the Failed surge row, keeps its status slot, closes the record and restores the source to Ready on its running revision
tick=18 apply timer.migrationDeadline to=t+32m1s now=t+32m1s
tick=18 row=1 write incarnation=1 phase=Failed runningRevision=nil readySince=nil op=nil lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=18 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-8aa14b8b readySince=t+1m0s op=nil precondition=ok
tick=18 migration uuid=uid#2 write phase=SurgePending→Failed message=surge allocated; waiting for surge pods→deadline exceeded in phase SurgePending: surge pods never became ready completedAt=nil→t+32m1s
tick=18 event Warning MigrationExpired OMENative migration uuid=uid#2 expired: deadline exceeded in phase SurgePending: surge pods never became ready; tearing down surge instance=1
tick=18 pass result=requeue
tick=19 note the unpinned index is beyond the desired set, so the scale-down pipeline commits Phase Deleting on it
tick=19 row=1 write incarnation=1 phase=Deleting runningRevision=nil readySince=nil op=op#4{type=Delete step=Drain started=t+32m1s lastProgressAt=t+32m1s deadline=t+1h2m1s} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=19 pass result=requeue
tick=20 note the drain finds nothing routed on the retired index, so its pod's delete is issued
tick=20 row=1 write no-op precondition=no-change
tick=20 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=20 pass result=none
tick=21 note the surge pod is gone, so its row is removed with it
tick=21 apply pod.deleted[target] pod=svc-a-engine-1-default-0 now=t+32m1s
tick=21 row=1 write no-op precondition=no-change
tick=21 row=1 remove incarnation=1 phase=Deleting runningRevision=nil readySince=nil op=op#4{type=Delete step=Drain started=t+32m1s lastProgressAt=t+32m1s deadline=t+1h2m1s} lastFailure={pod=svc-a-engine-1-default-0 reason=Unschedulable message=Unschedulable} precondition=ok
tick=21 pass result=requeue
