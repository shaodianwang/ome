tick=5 note the deadline elapses on a rebuilt pod that never came up; the ladder counts the wave and the attempt is parked with the row Failed
tick=5 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=5 row=0 write no-op precondition=no-change
tick=5 hold cleared
tick=5 retryblock target=svc-a-engine-6f8b1e6c persist nil→{state=Backoff attempts=1 nextRetryAt=t+1h30m1s reason=DeadlineExceeded}
