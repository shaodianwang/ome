tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod is deleted out from under the Instance, so the repair opens a Restart and rebuilds it
tick=2 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 row=0 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod count 0 below desired 1 (incarnation=2)
tick=2 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=2 ordinal=0
tick=2 pass result=after:5s
tick=3 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=3 apply clock.advance by=2m0s now=t+2m0s
tick=3 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note a corrective revision lands; the row is off the roll target, so the roll replaces the parked repair with a fresh recreate attempt and drains the wedged pod
tick=4 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+2m0s
tick=4 row=0 write incarnation=3 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=4 event Normal RecreateUpdateStarted OMENative component=engine instance=0 recreate (revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c, incarnation=3)
tick=4 pod delete name=svc-a-engine-0-default-0 grace=default
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the template moves again and the wedged pod is gone; the row is the fresh attempt's, which retargets and rebuilds
tick=5 apply spec.revision image=registry.example.com/runtime:v3 generation=2 now=t+2m0s
tick=5 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=5 row=0 write incarnation=4 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-2dd013c9 readySince=t+0s op=op#2{type=Update step=Drain target=svc-a-engine-2dd013c9 reason=revision svc-a-engine-882059bb -> svc-a-engine-2dd013c9 strategy=RecreatePod started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=5 pod create name=svc-a-engine-0-default-0 revision=2dd013c9 incarnation=4 ordinal=0
tick=5 hold cleared
tick=5 pass result=after:5s
