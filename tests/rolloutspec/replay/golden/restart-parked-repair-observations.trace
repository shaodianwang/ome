tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod is deleted out from under the Instance, so the repair opens a Restart and rebuilds it
tick=2 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 row=0 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod count 0 below desired 1 (incarnation=2)
tick=2 pod create name=svc-a-engine-0-default-0 revision=8aa14b8b incarnation=2 ordinal=0
tick=2 pass result=after:5s
tick=3 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=3 apply clock.advance by=2m0s now=t+2m0s
tick=3 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=ome-container message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the wedged pod is bound; binding is observation only
tick=4 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-1 now=t+2m0s
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the pod's endpoint enters the routed Service; the resume reads ContainersReady and PodReady, never the endpoints
tick=5 apply endpoint.rotationIn[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=5 hold cleared
tick=5 pass result=after:5s
tick=6 note the endpoint leaves again; a parked repair's set is out of rotation and leaving it moves counters alone
tick=6 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=6 hold cleared
tick=6 pass result=after:5s
tick=7 note the gate is withdrawn from a pod that never carried it; nothing is written
tick=7 apply pod.servingOff[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=7 hold cleared
tick=7 pass result=after:5s
tick=8 note the runner restarts in place; restart evidence is read against ReadySince for a Ready row only, and this wedge is already recorded
tick=8 apply pod.containerRestart pod=svc-a-engine-0-default-0 container=ome-container reason=OOMKilled now=t+2m0s
tick=8 hold cleared
tick=8 pass result=after:5s
tick=9 note the pod reappears under a new UID, fresh and Pending; the exits read the incarnation label, not the UID
tick=9 apply pod.uidRotated pod=svc-a-engine-0-default-0 uid=uid#2→uid#3 now=t+2m0s
tick=9 hold cleared
tick=9 pass result=after:5s
tick=10 note a queue admission gates the fresh pod; a gate parks no clock on a row whose clock is the ladder's
tick=10 apply pod.schedulingGated pod=svc-a-engine-0-default-0 now=t+2m0s
tick=10 hold cleared
tick=10 pass result=after:5s
tick=11 note the queue admits the pod; the deadline reconciler restarts no clock for a Failed row
tick=11 apply pod.admitted pod=svc-a-engine-0-default-0 now=t+2m0s
tick=11 hold cleared
tick=11 pass result=after:5s
tick=12 note the pod is bound and its node goes NotReady; node-death evidence reaches the row through its pods and the sweep, and no exit reads it directly
tick=12 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-2 now=t+2m0s
tick=12 apply pod.nodeLost[NodeNotReady] pod=svc-a-engine-0-default-0 node=node-2 evidence=NodeNotReady since=t+2m0s now=t+2m0s
tick=12 hold cleared
tick=12 pass result=after:5s
tick=13 note the kubelet stops reporting and the pod reads Unknown, which is not terminal; the pod stays a live name-holder the close never counts out
tick=13 apply pod.phaseTerminal[Unknown] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=13 hold cleared
tick=13 pass result=after:5s
tick=14 note a tick with nothing changed re-evaluates the set and writes nothing
tick=14 hold cleared
tick=14 pass result=after:5s
tick=15 note the controller restarts; the kept operation and the recorded failure are persisted, so the next manager reads the same park
tick=15 apply ctrl.crash expectations=dropped now=t+2m0s
tick=15 hold cleared
tick=15 pass result=after:5s
tick=16 note the cache lags one event behind for this pass; every exit re-reads the row and nothing is written
tick=16 apply ctrl.staleRead cache=end-of-tick-15 now=t+2m0s
tick=16 hold cleared
tick=16 pass result=after:5s
tick=17 note the queue label moves; the edit is outside the revision hash, so the target is unchanged and the exits stand
tick=17 apply spec.annotationOnly labels=[kueue.x-k8s.io/queue-name:queue-b] generation=1 now=t+2m0s
tick=17 hold cleared
tick=17 pass result=after:5s
tick=18 note the update strategy changes; a repair rebuilds at the running revision whatever the strategy says
tick=18 apply spec.strategy strategy=RecreatePod generation=2 now=t+2m0s
tick=18 hold cleared
tick=18 pass result=after:5s
tick=19 note the in-place mark-not-ready knob flips; it is read by no exit of a parked repair
tick=19 apply spec.policyTuning[markNotReady] markNotReady=true generation=3 now=t+2m0s
tick=19 hold cleared
tick=19 pass result=after:5s
tick=20 note the replica count grows; the new index is the Create pass's and this row's index stays in the desired set as it was
tick=20 apply spec.replicasUp replicas=2 generation=4 now=t+2m0s
tick=20 hold cleared
tick=20 row=1 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#2{type=Create step=CreatePods target=svc-a-engine-8aa14b8b started=t+2m0s lastProgressAt=t+2m0s deadline=t+32m0s} precondition=ok
tick=20 event Normal InstanceCreated OMENative component=engine instance=1 materialized; 1 pod(s) requested
tick=20 pod create name=svc-a-engine-1-default-0 revision=8aa14b8b incarnation=1 ordinal=0
tick=20 pass result=after:5s
