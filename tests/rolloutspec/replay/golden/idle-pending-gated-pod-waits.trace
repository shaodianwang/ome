tick=1 note a queue admission gates the pod; it counts as present, so the Create pass creates no duplicate and waits
tick=1 apply pod.schedulingGated pod=svc-a-engine-0-default-0 now=t+0s
tick=1 hold cleared
tick=1 pass result=after:5s
tick=2 note the queue admits the pod and the scheduler refuses it a node; a Pending row carries no operation for the scheduler hold to record
tick=2 apply pod.admitted pod=svc-a-engine-0-default-0 now=t+0s
tick=2 apply pod.unschedulable[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 row=0 write no-op precondition=no-change
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the pod is bound and reports Ready, so the Create pass promotes the row
tick=3 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-1 now=t+0s
tick=3 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+0s
