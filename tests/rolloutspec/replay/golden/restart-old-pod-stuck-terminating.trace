tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note after a minute of steady serving the runner restarts, so the repair opens a Restart and takes the pod out of serving
tick=2 apply clock.advance by=1m0s now=t+1m0s
tick=2 apply pod.containerRestart pod=svc-a-engine-0-default-0 container=ome-container reason=OOMKilled now=t+1m0s
tick=2 row=0 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Restart step=Drain reason=pod svc-a-engine-0-default-0 container ome-container restarted after Ready: OOMKilled (exit 1) started=t+1m0s lastProgressAt=t+1m0s deadline=t+31m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=OOMKilled container=ome-container exitCode=1} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod svc-a-engine-0-default-0 container ome-container restarted after Ready: OOMKilled (exit 1) (incarnation=2)
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=2 pass result=after:5s
tick=3 note the old pod leaves rotation, so the drain deletes it
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+1m0s
tick=3 row=0 write no-op precondition=no-change
tick=3 pod delete name=svc-a-engine-0-default-0 grace=default
tick=3 pass result=after:5s
tick=4 note the node under the Terminating pod stops reporting; the pod stays Terminating and holds Phase A on the live old-pod check, and with no force-delete policy no node is read for it
tick=4 apply pod.nodeLost[UnreachableTaint] pod=svc-a-engine-0-default-0 node=node-0 evidence=UnreachableTaint since=t+1m0s now=t+1m0s
tick=4 row=0 write no-op precondition=no-change
tick=4 pass result=after:5s
tick=5 note the kubelet never acknowledges the deletion, which leaves the object behind with no finalizer on it; nothing frees the name and the drain stays blocked
tick=5 apply pod.stuckTerminating pod=svc-a-engine-0-default-0 deletionDeadline=t+1m0s now=t+1m0s
tick=5 row=0 write no-op precondition=no-change
tick=5 pass result=after:5s
tick=6 note the operation deadline elapses on a pod deleting past its own deletion deadline, which is live for the stamp, so the row fails with the Restart operation preserved
tick=6 apply timer.operationDeadline to=t+31m1s now=t+31m1s
tick=6 row=0 write no-op precondition=no-change
tick=6 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Restart step=Drain reason=pod svc-a-engine-0-default-0 container ome-container restarted after Ready: OOMKilled (exit 1) started=t+1m0s lastProgressAt=t+1m0s deadline=t+31m0s} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Restart/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=6 warn instanceFailed index=0 pod=nil reason=DeadlineExceeded: Restart/Drain exceeded InstanceReadyTimeout
tick=6 pass result=after:5s
tick=7 note a further pass leaves the parked repair alone and re-asserts no gate; the stuck pod is live until it is gone, so the close waits on it
tick=7 hold cleared
tick=7 pass result=after:5s
tick=8 note the object is finally gone, so no live pod is left and the restart pass closes the spent operation
tick=8 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+31m1s
tick=8 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=nil lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Restart/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=8 event Normal RepairClosed OMENative component=engine instance=0 repair parked after DeadlineExceeded: Restart/Drain exceeded InstanceReadyTimeout closed: no live pod left to resume or rebuild; the Create pass rebuilds the Instance as a fresh start
tick=8 pass result=after:5s
tick=9 note the Failed row has no operation and no pod, so the Create pass rebuilds it as a fresh start
tick=9 hold cleared
tick=9 row=0 write incarnation=2 phase=Creating runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#2{type=Create step=CreatePods target=svc-a-engine-8aa14b8b started=t+31m1s lastProgressAt=t+31m1s deadline=t+1h1m1s} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Restart/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=9 pod create name=svc-a-engine-0-default-0 revision=8aa14b8b incarnation=2 ordinal=0
tick=9 pass result=after:5s
