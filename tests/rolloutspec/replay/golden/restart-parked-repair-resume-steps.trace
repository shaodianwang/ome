tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note the serving gate is flipped on the wedged pod by another hand; the gate is the resume's to write after ContainersReady, so nothing is written
tick=4 apply pod.servingOn[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the container starts and the pod reports ContainersReady; the gate the resume would write is already on the pod, so nothing is written and the promote waits for PodReady
tick=5 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=5 pass result=after:5s
tick=6 note the pod's readiness regresses while it keeps running, which withdraws the resume's precondition; the set reads wedged again and the row keeps its state
tick=6 apply pod.containersNotReady[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=6 hold cleared
tick=6 pass result=after:5s
tick=7 note the pod reports ContainersReady and PodReady in one observation, so the resume promotes the row on its running revision at the incarnation the pod carries
tick=7 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=7 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=7 row=0 write incarnation=2 phase=Ready runningRevision=svc-a-engine-882059bb readySince=t+2m0s op=nil lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=7 event Normal RestartCompleted OMENative component=engine instance=0 restart complete (incarnation=2)
tick=7 hold cleared
tick=7 pass result=none
tick=8 note the readiness is re-observed on the Ready row; the repair is over and nothing is written
tick=8 apply pod.containersReady[source] pod=svc-a-engine-0-default-0 now=t+2m0s
tick=8 hold cleared
tick=8 row=0 write no-op precondition=no-change
