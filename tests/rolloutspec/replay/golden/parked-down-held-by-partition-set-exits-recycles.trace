tick=1 note both Ready rows are steady on their serving pods
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 row=1 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod template changes; the partition holds the lowest Instance on its revision and the roll drains the other for a recreate
tick=2 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=2 gate consult strategy=RecreatePod surge=0 unavail=0 verdict=allow
tick=2 row=1 write incarnation=2 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Drain target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c strategy=RecreatePod started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Normal RecreateUpdateStarted OMENative component=engine instance=1 recreate (revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c, incarnation=2)
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the rolling pod leaves rotation, so it is deleted
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 row=1 write no-op precondition=no-change
tick=3 pod delete name=svc-a-engine-1-default-0 grace=default
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the old pod is gone, so the rebuild lands at the new revision
tick=4 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 row=1 write no-op precondition=no-change
tick=4 pod create name=svc-a-engine-1-default-0 revision=6f8b1e6c incarnation=2 ordinal=0
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the deadline elapses on a rebuilt pod that never came up; the ladder counts the wave and the attempt is parked with the row Failed
tick=5 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=5 row=1 write no-op precondition=no-change
tick=5 hold cleared
tick=5 row=1 write no-op precondition=no-change
tick=5 retryblock target=svc-a-engine-6f8b1e6c persist nil→{state=Backoff attempts=1 nextRetryAt=t+1h30m1s reason=DeadlineExceeded}
tick=5 row=1 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Parked target=svc-a-engine-6f8b1e6c reason=revision svc-a-engine-882059bb -> svc-a-engine-6f8b1e6c waiting=RetryBlock strategy=RecreatePod started=t+0s lastProgressAt=t+0s deadline=nil} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=5 warn instanceFailed index=1 pod=nil reason=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout: attempt disposed terminal (no workload-caused evidence, relocation unavailable) and counted on the revision's retry ladder
tick=5 pass result=after:5s
tick=6 note the partition is raised to two, so the parked row is held like the Failed row it stands for and the roll may not take it
tick=6 apply spec.partition partition=2 generation=2 now=t+30m1s
tick=6 hold gate=RetryBlock target=svc-a-engine-6f8b1e6c reason=update to svc-a-engine-6f8b1e6c in backoff after 1 failed attempt(s): DeadlineExceeded
tick=6 row=0 write no-op precondition=no-change
tick=6 pass result=after:5s
tick=7 note the block comes due; the partition keeps the roll off the parked row, and while its pod stands the Create pass leaves it alone
tick=7 apply timer.retryAt to=t+1h30m2s now=t+1h30m2s
tick=7 hold cleared
tick=7 row=0 write no-op precondition=no-change
tick=7 pass result=after:5s
tick=8 note the parked pod exits with phase Failed; every pod of the set is terminal, so the Create pass claims the row under a fresh Create attempt pinned to the target, replacing the parked one, and deletes the dead occupant with a TerminalPodRecycled warning
tick=8 apply pod.phaseTerminal[Failed] pod=svc-a-engine-1-default-0 now=t+1h30m2s
tick=8 hold cleared
tick=8 row=0 write no-op precondition=no-change
tick=8 row=1 write incarnation=2 phase=Creating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Create step=CreatePods target=svc-a-engine-6f8b1e6c started=t+1h30m2s lastProgressAt=t+1h30m2s deadline=t+2h0m2s} lastFailure={pod= reason=DeadlineExceeded message=DeadlineExceeded: Update/Drain exceeded InstanceReadyTimeout} precondition=ok
tick=8 retryblock target=svc-a-engine-6f8b1e6c persist {state=Backoff attempts=1 nextRetryAt=t+1h30m1s reason=DeadlineExceeded}→{state=RetryInProgress attempts=1 nextRetryAt=t+1h30m1s reason=DeadlineExceeded}
tick=8 row=1 write incarnation=2 phase=Creating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Create step=CreatePods target=svc-a-engine-6f8b1e6c retryCount=1 started=t+1h30m2s lastProgressAt=t+1h30m2s deadline=t+2h0m2s} lastFailure={pod=svc-a-engine-1-default-0 reason=Failed container=main exitCode=1} precondition=ok
tick=8 pod delete name=svc-a-engine-1-default-0 grace=default
tick=8 event Warning TerminalPodRecycled OMENative component=engine instance=1 deleted terminal pod(s) svc-a-engine-1-default-0 (Failed) for recreate (Create recycle 1)
tick=8 pass result=after:5s
tick=9 note the dead pod is gone, so the Create attempt recreates it at the target
tick=9 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+1h30m2s
tick=9 hold cleared
tick=9 row=0 write no-op precondition=no-change
tick=9 row=1 write no-op precondition=no-change
tick=9 pod create name=svc-a-engine-1-default-0 revision=6f8b1e6c incarnation=2 ordinal=0
