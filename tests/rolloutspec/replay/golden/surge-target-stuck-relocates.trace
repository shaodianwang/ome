tick=1 pod create name=svc-a-engine-0-default-1 revision=6f8b1e6c incarnation=1 ordinal=1
tick=1 gate consult strategy=SurgeThenDrain surge=1 unavail=0 verdict=allow
tick=1 row=1 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=Surge target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal RecreateUpdateStarted OMENative component=engine instance=1 surge to revision svc-a-engine-6f8b1e6c (newOrdinal=1)
tick=1 pod create name=svc-a-engine-1-default-1 revision=6f8b1e6c incarnation=1 ordinal=1
tick=1 hold cleared
tick=1 pass result=after:5s
tick=2 note Instance 1's replacement is bound to node-2, serves and enters rotation, so the new revision is known to work
tick=2 apply pod.scheduled[target] pod=svc-a-engine-1-default-1 node=node-2 now=t+0s
tick=2 apply pod.ready[target] pod=svc-a-engine-1-default-1 now=t+0s
tick=2 apply endpoint.rotationIn[target] pod=svc-a-engine-1-default-1 now=t+0s
tick=2 row=0 write no-op precondition=no-change
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-1 serving=absent→True
tick=2 row=1 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=SurgeDrain target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note Instance 1's source leaves rotation and is deleted, so Instance 1 promotes on the new revision
tick=3 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=1 write no-op precondition=no-change
tick=3 row=1 write incarnation=1 phase=Ready runningRevision=svc-a-engine-6f8b1e6c activeOrdinal=1 readySince=t+0s op=nil precondition=ok
tick=3 event Normal RecreateUpdateCompleted OMENative component=engine instance=1 surge to revision svc-a-engine-6f8b1e6c complete (activeOrdinal=1)
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note Instance 0's replacement is bound to node-1 and wedges there; with no stuck-pod grace configured nothing escalates yet
tick=4 apply pod.scheduled[target] pod=svc-a-engine-0-default-1 node=node-1 now=t+0s
tick=4 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-1 reason=CrashLoopBackOff now=t+0s
tick=4 row=0 write no-op precondition=no-change
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the operation deadline elapses; the attempt is disposed with a relocation directive against node-1, the replacement's node, while the source keeps serving on node-0
tick=5 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=5 row=0 write no-op precondition=no-change
tick=5 hold cleared
tick=5 row=0 write no-op precondition=no-change
tick=5 migration uuid=uid#5 append trigger=Auto phase=Relocated source=0 surge=nil fromNode=node-1 attempt=1 reason=AutoRecover message=relocation directive recorded; rebuild steered off node node-1 allocatedAt=nil deadline=t+30m1s completedAt=t+30m1s
tick=5 event Normal AutoMigrationTriggered OMENative component=engine instance=0 relocation directive recorded: attempt 1/3, rebuild steered off node node-1 (uuid=uid#5)
tick=5 row=0 write incarnation=1 phase=Failed runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=nil lastFailure={pod=svc-a-engine-0-default-1 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=5 warn instanceFailed index=0 pod=nil reason=DeadlineExceeded: Update/Surge exceeded InstanceReadyTimeout: attempt disposed with relocation directive; the rebuild is steered off the recorded node
tick=5 pass result=after:5s
