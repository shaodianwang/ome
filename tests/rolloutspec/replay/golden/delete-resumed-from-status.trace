tick=1 note the resumed wave finds the retired row Delete-owned and takes its pod out of rotation
tick=1 row=1 write no-op precondition=no-change
tick=1 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=1 pass result=after:30s
tick=2 note the pod leaves rotation, which is the drain the delete waits on
tick=2 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=2 pass result=after:30s
tick=3 note the drained pod is gone, so the row is removed with it
tick=3 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 row=1 write no-op precondition=no-change
tick=3 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pass result=requeue
tick=4 note nothing is left in flight
tick=4 hold cleared
tick=4 row=0 write no-op precondition=no-change
tick=4 pass result=none
