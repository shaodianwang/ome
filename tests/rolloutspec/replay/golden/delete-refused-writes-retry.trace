tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the apiserver refuses the drain patch as invalid, so the pass ends on the error with the retired pod still serving
tick=2 apply api.invalid verb=patch resource=pods count=1 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch-rejected name=svc-a-engine-1-default-0 rejection=api.invalid
tick=2 pass result=none err:workload.Reconcile: delete batch: DeleteBatch: mark not serving (instance=1, pod=svc-a-engine-1-default-0): patch ome.io/serving on pod ns-a/svc-a-engine-1-default-0: Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0
tick=3 note the next pass issues the same patch again and it lands; the pod is still in rotation, so no delete follows yet
tick=3 row=1 write no-op precondition=no-change
tick=3 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=3 pass result=after:30s
tick=4 note the pod leaves rotation and the apiserver refuses the wave's delete as invalid, so the expectation rolls back and the pass ends with the pod still there
tick=4 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 apply api.invalid verb=delete resource=pods count=1 now=t+0s
tick=4 row=1 write no-op precondition=no-change
tick=4 pod delete-rejected name=svc-a-engine-1-default-0 rejection=api.invalid
tick=4 pass result=none err:workload.Reconcile: delete batch: DeleteBatch: delete pod ns-a/svc-a-engine-1-default-0: Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0
tick=5 note the next pass re-reads the set and issues the same delete again
tick=5 row=1 write no-op precondition=no-change
tick=5 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=5 pass result=after:30s
tick=6 note the pod is gone and the row leaves the owner's status
tick=6 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=6 row=1 write no-op precondition=no-change
tick=6 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=6 pass result=requeue
