tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the apiserver refuses the drain patch as invalid; the row is disposed Failed with the reason, the revision in force is held and one Warning names the pod, with the retired pod still serving
tick=2 apply api.invalid verb=patch resource=pods count=1 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch-rejected name=svc-a-engine-1-default-0 rejection=api.invalid
tick=2 retryblock target=svc-a-engine-882059bb persist nil→{state=Held attempts=1 reason=InvalidPodSpec}
tick=2 warn retryHeld target=svc-a-engine-882059bb attempts=1 reason=InvalidPodSpec
tick=2 row=1 write incarnation=1 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=nil lastFailure={pod=svc-a-engine-1-default-0 reason=InvalidPodSpec message=Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0} precondition=ok
tick=2 event Warning InstanceRejected OMENative component=engine instance=1: apiserver rejected pod svc-a-engine-1-default-0 (InvalidPodSpec: Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0); revision svc-a-engine-882059bb held for retry
tick=2 hold cleared
tick=2 row=0 write no-op precondition=no-change
tick=2 pass result=none
tick=3 note the next pass leaves the row as the rejection left it and issues no write; the ladder denies a fresh start
tick=3 hold gate=Held target=svc-a-engine-882059bb reason=update to svc-a-engine-882059bb held after 1 failed attempt(s): InvalidPodSpec
tick=3 row=0 write no-op precondition=no-change
tick=3 pass result=none
tick=4 note the pod leaves rotation on its own; the row is out of the wave's selection, so no delete is issued and the staged refusal is never consumed
tick=4 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 apply api.invalid verb=delete resource=pods count=1 now=t+0s
tick=4 hold gate=Held target=svc-a-engine-882059bb reason=update to svc-a-engine-882059bb held after 1 failed attempt(s): InvalidPodSpec
tick=4 row=0 write no-op precondition=no-change
tick=4 pass result=none
tick=5 note a further pass still issues nothing
tick=5 hold gate=Held target=svc-a-engine-882059bb reason=update to svc-a-engine-882059bb held after 1 failed attempt(s): InvalidPodSpec
tick=5 row=0 write no-op precondition=no-change
tick=5 pass result=none
tick=6 note the pod is gone, so nothing of the refused write is left to refuse; the wave takes the row again and re-opens its Delete operation
tick=6 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=6 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=InvalidPodSpec message=Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0} precondition=ok
tick=6 pass result=requeue
tick=7 note the next pass finds no pod behind the row and removes it from the owner's status
tick=7 row=1 write no-op precondition=no-change
