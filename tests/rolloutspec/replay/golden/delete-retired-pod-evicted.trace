tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the retired pod is evicted under memory pressure; its endpoint is still published, so the wave withdraws the gate and keeps waiting on the drain
tick=2 apply pod.evicted pod=svc-a-engine-1-default-0 reason=Evicted now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 pass result=after:30s
tick=3 note the evicted object is gone, which the wave counts as progress, so the row leaves the owner's status
tick=3 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=3 row=1 write no-op precondition=no-change
tick=3 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pass result=requeue
