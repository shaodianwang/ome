tick=1 note the operator halves the replica count, and the demoted Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note a queue admission gates the retired pod and the queue label moves; a gated pod is trivially drained, so the wave deletes it at once, and the edit cannot put the index back
tick=2 apply pod.schedulingGated pod=svc-a-engine-1-default-0 now=t+0s
tick=2 apply spec.annotationOnly labels=[kueue.x-k8s.io/queue-name:queue-b] generation=2 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=2 pass result=after:30s
tick=3 note the queue admits the pod on its way out and a partition is set; gate exit writes nothing for a draining index and the partition bounds the update selection alone
tick=3 apply pod.admitted pod=svc-a-engine-1-default-0 now=t+0s
tick=3 apply spec.partition partition=1 generation=3 now=t+0s
tick=3 row=1 write no-op precondition=no-change
tick=3 pass result=after:30s
tick=4 note the pod is gone and the row leaves the owner's status
tick=4 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 row=1 write no-op precondition=no-change
tick=4 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=4 pass result=requeue
