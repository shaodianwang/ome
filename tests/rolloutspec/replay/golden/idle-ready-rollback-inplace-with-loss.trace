tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note only the image changes, so the update is eligible to run in place
tick=2 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=2 gate consult strategy=InPlaceIfPossible surge=0 unavail=0 verdict=allow
tick=2 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=InPlace target=svc-a-engine-6f8b1e6c strategy=InPlaceIfPossible started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
