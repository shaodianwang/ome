tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the template moves to v2, so the rollout surges a replacement
tick=2 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=2 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=2 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=Surge target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Normal RecreateUpdateStarted OMENative component=engine instance=0 surge to revision svc-a-engine-6f8b1e6c (newOrdinal=1)
tick=2 pod create name=svc-a-engine-0-default-1 revision=6f8b1e6c incarnation=1 ordinal=1
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note the replacement is serving and in rotation beside the source
tick=3 apply pod.ready[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=3 apply endpoint.rotationIn[target] pod=svc-a-engine-0-default-1 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 pod status-patch name=svc-a-engine-0-default-1 serving=absent→True
tick=3 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=SurgeDrain target=svc-a-engine-6f8b1e6c strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the source leaves rotation, so the drain has converged
tick=4 apply endpoint.rotationOut[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=4 row=0 write no-op precondition=no-change
tick=4 row=0 write no-op precondition=no-change
tick=4 pod delete name=svc-a-engine-0-default-0 grace=default
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the drained source is gone and the Instance is Ready on v2
tick=5 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=5 row=0 write no-op precondition=no-change
tick=5 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-6f8b1e6c activeOrdinal=1 readySince=t+0s op=nil precondition=ok
tick=5 event Normal RecreateUpdateCompleted OMENative component=engine instance=0 surge to revision svc-a-engine-6f8b1e6c complete (activeOrdinal=1)
tick=5 hold cleared
tick=5 pass result=requeue
tick=6 note the roll is pinned back to v1 as the template moves to v3; the surge targets the pinned revision and renders its stored template, not the new one
tick=6 apply spec.rollbackTarget[set] rollbackTo=registry.example.com/runtime:v1 generation=2 now=t+0s
tick=6 apply spec.revision image=registry.example.com/runtime:v3 generation=3 now=t+0s
tick=6 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=6 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-6f8b1e6c targetRevision=svc-a-engine-882059bb activeOrdinal=1 readySince=t+0s op=op#1{type=Update step=Surge target=svc-a-engine-882059bb strategy=SurgeThenDrain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=6 event Normal RecreateUpdateStarted OMENative component=engine instance=0 surge to revision svc-a-engine-882059bb (newOrdinal=0)
tick=6 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=1 ordinal=0
tick=6 hold cleared
tick=6 pass result=after:5s
