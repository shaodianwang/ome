tick=1 note only the image changed, so both Instances are eligible to run the update in place
tick=1 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=1 gate consult strategy=InPlaceIfPossible surge=0 unavail=0 verdict=allow
tick=1 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#1{type=Update step=InPlace target=svc-a-engine-6f8b1e6c strategy=InPlaceIfPossible started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InPlaceUpdateStarted OMENative component=engine instance=0 in-place update to revision svc-a-engine-6f8b1e6c
tick=1 pod status-patch name=svc-a-engine-0-default-0 serving=True→False
tick=1 gate consult strategy=InPlaceIfPossible surge=0 unavail=1 verdict=allow
tick=1 row=1 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#2{type=Update step=InPlace target=svc-a-engine-6f8b1e6c strategy=InPlaceIfPossible started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InPlaceUpdateStarted OMENative component=engine instance=1 in-place update to revision svc-a-engine-6f8b1e6c
tick=1 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=1 hold cleared
tick=1 pass result=after:5s
tick=2 note the operator halves the replica count as the retired pod reports ready and a further image edit lands, so the retired index leaves the plan whatever it reports
tick=2 apply spec.replicasDown replicas=1 generation=2 now=t+0s
tick=2 apply pod.containersReady[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=2 apply spec.revision image=registry.example.com/runtime:v3 generation=3 now=t+0s
tick=2 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#3{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pass result=requeue
tick=3 note the scale-down wave still polls the retired index, so nothing else runs on this pass
tick=3 row=1 write no-op precondition=no-change
tick=3 pass result=after:30s
tick=4 note the retired index's pod leaves rotation, which is the drain the delete waits on
tick=4 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 row=1 write no-op precondition=no-change
tick=4 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=4 pass result=after:30s
tick=5 note the drained pod is gone, so the row is removed with it
tick=5 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=5 row=1 write no-op precondition=no-change
tick=5 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#3{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=5 pass result=requeue
tick=6 note with the wave done, the remaining Instance retargets in place toward the newer revision
tick=6 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-2dd013c9 readySince=t+0s op=op#1{type=Update step=InPlace target=svc-a-engine-2dd013c9 strategy=InPlaceIfPossible started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=6 hold cleared
