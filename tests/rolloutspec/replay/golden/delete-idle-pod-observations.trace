tick=1 note the operator halves the replica count, and the retired Instance is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the first drive takes the retired pod's serving gate down and finds it still in rotation, so the wave polls
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-default-0 serving=True→False
tick=2 pass result=after:30s
tick=3 note a reconcile with nothing new re-reads the same pod set and writes nothing
tick=3 row=1 write no-op precondition=no-change
tick=3 pass result=after:30s
tick=4 note a minute on, the retired pod is re-bound and reports its containers ready again, which the drain never reads
tick=4 apply clock.advance by=1m0s now=t+1m0s
tick=4 apply pod.scheduled[source] pod=svc-a-engine-1-default-0 node=node-1 now=t+1m0s
tick=4 apply pod.containersReady[source] pod=svc-a-engine-1-default-0 now=t+1m0s
tick=4 row=1 write no-op precondition=no-change
tick=4 pass result=after:30s
tick=5 note the retired pod's runner restarts after Ready, and the restart trigger that would rebuild a Ready Instance is blind to a draining one
tick=5 apply pod.containerRestart pod=svc-a-engine-1-default-0 container=ome-container reason=OOMKilled now=t+1m0s
tick=5 row=1 write no-op precondition=no-change
tick=5 pass result=after:30s
tick=6 note the retired pod leaves rotation, which is the one signal the drain reads, so the wave issues the graceful delete
tick=6 apply endpoint.rotationOut[source] pod=svc-a-engine-1-default-0 now=t+1m0s
tick=6 row=1 write no-op precondition=no-change
tick=6 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=6 pass result=after:30s
tick=7 note the terminating pod's container dies and its phase goes Failed, and the row still waits for the object to be gone
tick=7 apply pod.phaseTerminal[Failed] pod=svc-a-engine-1-default-0 now=t+1m0s
tick=7 row=1 write no-op precondition=no-change
tick=7 pass result=after:30s
tick=8 note the pod is gone and the row leaves the owner's status
tick=8 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+1m0s
tick=8 row=1 write no-op precondition=no-change
tick=8 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=8 pass result=requeue
tick=9 note the Component is at rest with the retired Instance gone
tick=9 hold cleared
tick=9 row=0 write no-op precondition=no-change
tick=9 pass result=none
