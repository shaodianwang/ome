tick=1 note the template changes, so the first gang claims the free index as its replacement and the other gang waits on the surge budget
tick=1 apply spec.revision image=registry.example.com/runtime:v2 generation=1 now=t+0s
tick=1 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=1 podgroup create name=svc-a-engine-0
tick=1 podgroup create name=svc-a-engine-1
tick=1 gate consult strategy=SurgeThenDrain surge=0 unavail=0 verdict=allow
tick=1 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-3363fef6 targetRevision=svc-a-engine-367ef4b7 readySince=t+0s op=op#1{type=Update step=Surge target=svc-a-engine-367ef4b7 strategy=SurgeThenDrain surgeIndex=2 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 row=2 write incarnation=1 phase=Creating runningRevision=nil targetRevision=svc-a-engine-367ef4b7 readySince=nil op=op#2{type=Update step=GangSurgeTarget target=svc-a-engine-367ef4b7 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal RecreateUpdateStarted OMENative component=engine instance=0 gang surge to revision svc-a-engine-367ef4b7 (surge-index=2)
tick=1 hold cleared
tick=1 pass result=after:5s
tick=2 note the replacement's PodGroup is announced before its first member, and both members are created
tick=2 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=2 podgroup create name=svc-a-engine-2
tick=2 row=2 write no-op precondition=no-change
tick=2 pod create name=svc-a-engine-2-leader-0 revision=367ef4b7 incarnation=1 ordinal=0
tick=2 pod create name=svc-a-engine-2-worker-0 revision=367ef4b7 incarnation=1 ordinal=0
tick=2 hold cleared
tick=2 pass result=after:5s
tick=3 note both replacement members report Ready and the leader enters rotation, so the source advances to the drain and leaves the serving gate
tick=3 apply pod.ready[target] pod=svc-a-engine-2-leader-0 now=t+0s
tick=3 apply pod.ready[target] pod=svc-a-engine-2-worker-0 now=t+0s
tick=3 apply endpoint.rotationIn[target] pod=svc-a-engine-2-leader-0 now=t+0s
tick=3 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=3 row=2 write no-op precondition=no-change
tick=3 pod status-patch name=svc-a-engine-2-leader-0 serving=absent→True
tick=3 pod status-patch name=svc-a-engine-2-worker-0 serving=absent→True
tick=3 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-3363fef6 targetRevision=svc-a-engine-367ef4b7 readySince=t+0s op=op#1{type=Update step=SurgeDrain target=svc-a-engine-367ef4b7 strategy=SurgeThenDrain surgeIndex=2 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pod status-patch name=svc-a-engine-0-leader-0 serving=True→False
tick=3 pod status-patch name=svc-a-engine-0-worker-0 serving=True→False
tick=3 hold cleared
tick=3 pass result=after:5s
tick=4 note the operator re-applies the starting revision with the replacement whole; past the Surge step the cycle finishes on its pin, so the replacement keeps its gate and nothing is abandoned
tick=4 apply spec.revision image=registry.example.com/runtime:v1 generation=2 now=t+0s
tick=4 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=4 row=2 write no-op precondition=no-change
tick=4 row=0 write no-op precondition=no-change
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the whole replacement gang dies behind the drained source with its revision already withdrawn, so the pair ends instead of closing an attempt the ladder would re-arm
tick=5 apply pod.deleted[target] pod=svc-a-engine-2-leader-0 now=t+0s
tick=5 apply pod.deleted[target] pod=svc-a-engine-2-worker-0 now=t+0s
tick=5 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=5 row=2 write no-op precondition=no-change
tick=5 pod status-patch name=svc-a-engine-0-leader-0 serving=False→True
tick=5 pod status-patch name=svc-a-engine-0-worker-0 serving=False→True
tick=5 row=2 write incarnation=1 phase=Creating runningRevision=nil targetRevision=svc-a-engine-367ef4b7 readySince=nil op=op#2{type=Update step=GangSurgeTargetCleanup target=svc-a-engine-367ef4b7 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=5 row=0 write no-op precondition=no-change
tick=5 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-3363fef6 readySince=t+0s op=nil precondition=ok
tick=5 row=2 remove incarnation=1 phase=Creating runningRevision=nil targetRevision=svc-a-engine-367ef4b7 readySince=nil op=op#2{type=Update step=GangSurgeTargetCleanup target=svc-a-engine-367ef4b7 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=5 event Normal GangSurgeAbandoned OMENative component=engine instance=0 abandoned gang surge (surge-index=2): the roll target moved off revision svc-a-engine-367ef4b7 while the replacement gang was short of members, so nothing is rebuilt at it; the source returns to rotation on revision svc-a-engine-3363fef6
tick=5 hold cleared
tick=5 pass result=after:5s
tick=6 note a pass with nothing changed
tick=6 condition type=GangSchedulingUnavailable status=False reason=GangSchedulingAvailable message=Gang scheduling is available or not required
tick=6 hold cleared
tick=6 row=0 write no-op precondition=no-change
tick=6 row=1 write no-op precondition=no-change
tick=6 pass result=none
