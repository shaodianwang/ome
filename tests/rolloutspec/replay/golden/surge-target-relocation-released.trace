tick=4 row=0 write no-op precondition=no-change
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the operation deadline elapses; the attempt is disposed with a relocation directive against node-1 and the wave is not counted on the ladder
tick=5 apply timer.operationDeadline to=t+30m1s now=t+30m1s
tick=5 row=0 write no-op precondition=no-change
tick=5 hold cleared
tick=5 row=0 write no-op precondition=no-change
tick=5 migration uuid=uid#5 append trigger=Auto phase=Relocated source=0 surge=nil fromNode=node-1 attempt=1 reason=AutoRecover message=relocation directive recorded; rebuild steered off node node-1 allocatedAt=nil deadline=t+30m1s completedAt=t+30m1s
tick=5 event Normal AutoMigrationTriggered OMENative component=engine instance=0 relocation directive recorded: attempt 1/3, rebuild steered off node node-1 (uuid=uid#5)
