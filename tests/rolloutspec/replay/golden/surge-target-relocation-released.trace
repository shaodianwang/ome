tick=1 note both sources are bound to node-0, then the pod template changes, so both Instances surge a replacement
tick=1 apply pod.scheduled[source] pod=svc-a-engine-0-default-0 node=node-0 now=t+0s
tick=1 apply pod.scheduled[source] pod=svc-a-engine-1-default-0 node=node-0 now=t+0s
