tick=7 hold cleared
tick=7 pass result=after:5s
tick=7 row=0 write incarnation=1 phase=Updating runningRevision=svc-a-engine-882059bb targetRevision=svc-a-engine-6f8b1e6c readySince=t+0s op=op#3{type=Update step=Surge target=svc-a-engine-6f8b1e6c waiting=Unschedulable strategy=SurgeThenDrain started=t+30m1s lastProgressAt=t+30m1s deadline=nil} lastFailure={pod=svc-a-engine-0-default-1 reason=Unschedulable} precondition=ok
tick=8 note the hold outlasts the grace; the exclusion of node-1 is released with one event, the attempt fails with the scheduler's verdict and no revision is charged
tick=8 apply clock.advance by=11m0s now=t+41m1s
tick=8 row=0 write no-op precondition=no-change
tick=8 row=0 write no-op precondition=no-change
tick=8 hold cleared
tick=8 row=0 write no-op precondition=no-change
