tick=1 note the operator halves the replica count, and the retired gang is admitted into a Delete operation
tick=1 apply spec.replicasDown replicas=1 generation=1 now=t+0s
tick=1 row=1 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 pass result=requeue
tick=2 note the retired leader leaves rotation, so the wave deletes both members
tick=2 apply endpoint.rotationOut[source] pod=svc-a-engine-1-leader-0 now=t+0s
tick=2 row=1 write no-op precondition=no-change
tick=2 pod status-patch name=svc-a-engine-1-leader-0 serving=True→False
tick=2 pod status-patch name=svc-a-engine-1-worker-0 serving=True→False
tick=2 pod delete name=svc-a-engine-1-leader-0 grace=default uidPrecondition=set
tick=2 pod delete name=svc-a-engine-1-worker-0 grace=default uidPrecondition=set
tick=2 pass result=after:30s
tick=3 note five minutes on the leader is still there behind a kubelet that is gone, and the operator asks the gang off its node in the same observation; the sweep force-deletes the leader and the request stays recorded, undriven, while the row exists
tick=3 apply clock.advance by=5m0s now=t+5m0s
tick=3 apply pod.stuckTerminating pod=svc-a-engine-1-leader-0 deletionDeadline=t+0s now=t+5m0s
tick=3 apply spec.migrateRequest uuid=uid#5 instance=1 fromNode=node-2 now=t+5m0s
tick=3 pod delete name=svc-a-engine-1-leader-0 grace=0 uidPrecondition=set
tick=3 event Warning PodForceDeleted OMENative component=engine instance=1: force-deleted stuck-Terminating pod svc-a-engine-1-leader-0 on node node-2 (evidence=node-gone, 5m0s past the pod's own deletion deadline)
tick=3 event Warning PodDeleteBlockedByFinalizer OMENative component=engine instance=1: pod svc-a-engine-1-worker-0 is 5m0s past its own deletion deadline but pinned by finalizers [replay.workload.ome.io/pod-lifecycle]; OME never strips another controller's finalizer — the finalizer owner must resolve it
tick=3 row=1 write no-op precondition=no-change
tick=3 pass result=after:30s
tick=4 note the worker is gone, which is the ordinary completion, and the row leaves the owner's status
tick=4 apply pod.deleted[source] pod=svc-a-engine-1-worker-0 now=t+5m0s
tick=4 row=1 write no-op precondition=no-change
tick=4 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=4 pass result=requeue
tick=5 note with the row gone the migrate pass fails the record for want of a source Instance
tick=5 migration uuid=uid#5 write phase=Accepted→Failed message=nil→source InstanceStatus missing completedAt=nil→t+5m0s
tick=5 event Warning MigrationRequestRejected OMENative migration uuid=uid#5 rejected: source InstanceStatus missing
tick=5 pass result=requeue
