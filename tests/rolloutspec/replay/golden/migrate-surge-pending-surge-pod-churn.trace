tick=4 note the surge reports ContainersReady, so the drive marks it serving and waits on its rotation and availability gates
tick=4 apply pod.containersReady[target] pod=svc-a-engine-1-default-0 now=t+0s
tick=4 row=0 write no-op precondition=no-change
