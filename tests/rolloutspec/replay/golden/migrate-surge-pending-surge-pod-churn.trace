tick=4 pass result=after:5s
tick=5 note the surge's serving gate drops, so the drive marks it serving again and the record keeps waiting
tick=5 apply pod.servingOff[target] pod=svc-a-engine-1-default-0 now=t+0s
tick=5 row=0 write no-op precondition=no-change
tick=5 row=1 write no-op precondition=no-change
tick=5 pod status-patch name=svc-a-engine-1-default-0 serving=False→True
tick=5 pass result=after:5s
tick=6 note the runner restarts on both the surge and the source, and the restart trigger declines both migrate-owned rows
tick=6 apply pod.containerRestart pod=svc-a-engine-1-default-0 container=ome-container reason=Error now=t+0s
tick=6 apply pod.containerRestart pod=svc-a-engine-0-default-0 container=ome-container reason=Error now=t+0s
tick=6 row=0 write no-op precondition=no-change
tick=6 row=1 write no-op precondition=no-change
tick=6 pass result=after:5s
tick=7 note the surge pod dies, and no pass replaces or stamps it while the pin is held, so the gates stall
tick=7 apply pod.phaseTerminal[Failed] pod=svc-a-engine-1-default-0 now=t+0s
tick=7 row=0 write no-op precondition=no-change
tick=7 row=1 write no-op precondition=no-change
tick=7 pass result=after:5s
tick=8 note the dead surge pod is gone, so the missing-pod diff re-creates it from the source's running revision
tick=8 apply pod.deleted[target] pod=svc-a-engine-1-default-0 now=t+0s
tick=8 row=0 write no-op precondition=no-change
tick=8 row=1 write no-op precondition=no-change
tick=8 pod create name=svc-a-engine-1-default-0 revision=8aa14b8b incarnation=1 ordinal=0
tick=8 pass result=after:5s
tick=9 note the fresh surge pod is deleted from outside and held Terminating, so it still occupies its name and nothing is re-created
tick=9 apply pod.terminating[target] pod=svc-a-engine-1-default-0 now=t+0s
tick=9 row=0 write no-op precondition=no-change
tick=9 row=1 write no-op precondition=no-change
tick=9 pass result=after:5s
