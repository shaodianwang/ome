tick=1 note the Instance is parked at Failed with its pod still present
tick=1 pass result=after:5s
tick=2 note the owner is deleted, so the Failed Instance is drained like any other
tick=2 apply spec.teardown[deleted] teardown=true now=t+0s
tick=2 row=0 write incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 pass result=requeue
tick=3 note the pod is gone and the row leaves the owner's status
tick=3 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=0 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=nil op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=3 pass result=requeue
