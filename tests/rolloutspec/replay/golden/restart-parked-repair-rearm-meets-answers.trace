tick=1 note the Ready row is steady on its one serving pod
tick=1 hold cleared
tick=1 row=0 write no-op precondition=no-change
tick=1 pass result=none
tick=2 note the pod is deleted out from under the Instance, so the repair opens a Restart and rebuilds it
tick=2 apply pod.deleted[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 row=0 write incarnation=2 phase=Restarting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=2 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: pod count 0 below desired 1 (incarnation=2)
tick=2 pod create name=svc-a-engine-0-default-0 revision=882059bb incarnation=2 ordinal=0
tick=2 pass result=after:5s
tick=3 note the rebuilt pod crash-loops and is older than the grace when the wedge is read, so the row fails with its operation preserved
tick=3 apply clock.advance by=2m0s now=t+2m0s
tick=3 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+2m0s
tick=3 row=0 write no-op precondition=no-change
tick=3 row=0 write incarnation=2 phase=Failed runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Restart step=Drain reason=pod count 0 below desired 1 started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=3 warn instanceFailed index=0 pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff
tick=3 pass result=after:5s
tick=4 note a not-found answer is armed for the next pod delete and an already-exists answer for the next pod create; a parked repair issues neither, so nothing consumes them
tick=4 apply api.notFound verb=delete resource=pods count=1 now=t+2m0s
tick=4 apply api.alreadyExists verb=create resource=pods count=1 now=t+2m0s
tick=4 hold cleared
tick=4 pass result=after:5s
tick=5 note the ladder's delay elapses, so the repair re-arms at the next incarnation and its drain meets the not-found answer, behind which the wedged pod is already gone
tick=5 apply timer.repairRetry to=t+7m1s now=t+7m1s
tick=5 row=0 write incarnation=3 phase=Restarting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#2{type=Restart step=Drain reason=repair re-armed (attempt 1) after pod svc-a-engine-0-default-0 container main stuck (CrashLoopBackOff) retryCount=1 started=t+7m1s lastProgressAt=t+7m1s deadline=t+37m1s} lastFailure={pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff container=main message=back-off restarting failed container} precondition=ok
tick=5 event Warning RestartTriggered OMENative component=engine instance=0 restart triggered: repair re-armed (attempt 1) after pod svc-a-engine-0-default-0 container main stuck (CrashLoopBackOff) (incarnation=3)
tick=5 pod delete-rejected name=svc-a-engine-0-default-0 rejection=api.notFound
tick=5 pass result=after:5s
tick=6 note the re-armed attempt's rebuild meets the already-exists answer and adopts the object that already holds the name
