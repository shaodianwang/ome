tick=1 note cold start opens the attempt on the Component's current revision
tick=1 hold cleared
tick=1 row=0 write incarnation=1 phase=Creating runningRevision=nil readySince=nil op=op#1{type=Create step=CreatePods target=svc-a-engine-8aa14b8b started=t+0s lastProgressAt=t+0s deadline=t+30m0s} precondition=ok
tick=1 event Normal InstanceCreated OMENative component=engine instance=0 materialized; 1 pod(s) requested
tick=1 pod create name=svc-a-engine-0-default-0 revision=8aa14b8b incarnation=1 ordinal=0
tick=1 pass result=after:5s
tick=2 note the pod becomes Ready and enters rotation, so the Instance promotes and ReadySince is stamped
tick=2 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 apply endpoint.rotationIn[source] pod=svc-a-engine-0-default-0 now=t+0s
tick=2 hold cleared
tick=2 pod status-patch name=svc-a-engine-0-default-0 serving=absent→True
tick=2 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=nil precondition=ok
tick=2 event Normal InstanceReady OMENative component=engine instance=0 is Ready (1 pod(s) serving)
tick=2 pass result=none
tick=3 note twenty seconds of steady serving, inside the crash window
tick=3 apply clock.advance by=20s now=t+20s
tick=3 hold cleared
tick=3 row=0 write no-op precondition=no-change
tick=3 pass result=none
tick=4 note the runner dies and the kubelet starts it again under the same pod; one restart is not a crash of the revision, so the ladder records nothing, and the set is merely unproven for the window
tick=4 apply pod.containerRestart pod=svc-a-engine-0-default-0 container=ome-container reason=Error now=t+20s
tick=4 hold cleared
tick=4 row=0 write no-op precondition=no-change
tick=4 pass result=after:40s
tick=5 note the restarted runner dies again and the kubelet backs off, so the loop counts one failed attempt on the running revision's ladder and the row remembers the crash; the pod is younger than the grace, so no repair opens, and the hold names the ladder in backoff
tick=5 apply pod.containersNotReady pod=svc-a-engine-0-default-0 now=t+20s
tick=5 apply pod.waiting[CrashLoopBackOff] pod=svc-a-engine-0-default-0 reason=CrashLoopBackOff now=t+20s
tick=5 retryblock target=svc-a-engine-8aa14b8b persist nil→{state=Backoff attempts=1 nextRetryAt=t+1m20s reason=CrashLoopBackOff}
tick=5 row=0 write incarnation=1 phase=Ready runningRevision=svc-a-engine-8aa14b8b readySince=t+0s op=nil lastFailure={pod=svc-a-engine-0-default-0 reason=Error container=ome-container exitCode=1} precondition=ok
tick=5 hold gate=Budget target=svc-a-engine-8aa14b8b reason=per-Component unavailability budget 0 exhausted; Instance 0 on revision svc-a-engine-8aa14b8b not serving; no source leaves rotation
tick=5 pass result=after:5s
tick=6 note ten seconds later the kubelet starts the runner again and the same pod serves, its status carrying the restart that brought it back; the set is in rotation and unproven for the window, so the hold stands as it was
tick=6 apply clock.advance by=10s now=t+30s
tick=6 apply pod.ready[source] pod=svc-a-engine-0-default-0 now=t+30s
tick=6 apply pod.containerRestart pod=svc-a-engine-0-default-0 container=ome-container reason=Error now=t+30s
tick=6 hold gate=RetryBlock target=svc-a-engine-8aa14b8b reason=update to svc-a-engine-8aa14b8b in backoff after 1 failed attempt(s): CrashLoopBackOff; Instance 0 on revision svc-a-engine-8aa14b8b not serving
tick=6 row=0 write no-op precondition=no-change
tick=6 pass result=after:50s
tick=7 note the backoff comes due with nothing to start and no rebuild owed to a serving set, so the hold names the attempt the healed set proves itself under, and the block is kept while it does
tick=7 apply timer.retryAt to=t+1m21s now=t+1m21s
tick=7 hold gate=RetryBlock target=svc-a-engine-8aa14b8b reason=update to svc-a-engine-8aa14b8b retrying one attempt at a time after 1 failed attempt(s): CrashLoopBackOff; Instance 0 on revision svc-a-engine-8aa14b8b not serving
tick=7 row=0 write no-op precondition=no-change
tick=7 pass result=after:9s
tick=8 note the healed set has held Ready for the window since it came back, so the hold clears and the block its rows outlived is pruned
tick=8 apply clock.advance by=10s now=t+1m31s
tick=8 hold cleared
tick=8 row=0 write no-op precondition=no-change
tick=8 retryblock target=svc-a-engine-8aa14b8b remove {state=Backoff attempts=1 nextRetryAt=t+1m20s reason=CrashLoopBackOff}→nil
tick=8 pass result=none
