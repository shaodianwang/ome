tick=6 row=1 write no-op precondition=no-change
tick=6 pod delete name=svc-a-engine-1-default-0 grace=default uidPrecondition=set
tick=6 pass result=after:30s
tick=7 note the pod is gone and the row leaves the owner's status
tick=7 apply pod.deleted[source] pod=svc-a-engine-1-default-0 now=t+0s
tick=7 row=1 write no-op precondition=no-change
tick=7 row=1 remove incarnation=1 phase=Deleting runningRevision=svc-a-engine-882059bb readySince=t+0s op=op#1{type=Delete step=Drain started=t+0s lastProgressAt=t+0s deadline=t+30m0s} lastFailure={pod=svc-a-engine-1-default-0 reason=InvalidPodSpec message=Pod "svc-a" is invalid: spec.containers[0].resources.limits: Invalid value: "-1": must be greater than or equal to 0} precondition=ok
