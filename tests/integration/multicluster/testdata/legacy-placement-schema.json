{
  "properties": {
    "capacityFactors": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
        "x-kubernetes-int-or-string": true
      },
      "type": "object"
    },
    "clusterSelector": {
      "type": "string"
    },
    "mode": {
      "default": "Single",
      "enum": [
        "Single",
        "All",
        "Split"
      ],
      "type": "string"
    },
    "requirements": {
      "type": "string"
    },
    "split": {
      "properties": {
        "maxReplicasPerCluster": {
          "format": "int32",
          "type": "integer"
        },
        "minReplicasPerCluster": {
          "format": "int32",
          "type": "integer"
        },
        "replicas": {
          "format": "int32",
          "type": "integer"
        },
        "spread": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
