# Rendered at container start: nginx's entrypoint runs envsubst over this file,
# substituting ${MUSE_BACKEND} (the only env var referenced). $uri / $host are
# left intact — envsubst only touches variables present in the environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Static SPA: fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API + live SSE stream → muse-server. No path on proxy_pass, so the full
    # /v1/... URI passes through unchanged. Streaming must not be buffered.
    location /v1 {
        proxy_pass ${MUSE_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
