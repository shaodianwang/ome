# Explicit local-development configuration for `make -C muse run`.
MUSE_HOST=127.0.0.1
MUSE_PORT=8080
MUSE_METRICS_PORT=9090
MUSE_LOG_JSON=false
MUSE_LOG_FILTER=info,muse=debug
MUSE_WORKER_THREAD_STACK_BYTES=67108864
MUSE_LOCAL_CLUSTER_NAME=local
MUSE_LIST_STRATEGY=auto
MUSE_APISERVER_PREFLIGHT_TIMEOUT_SECS=15
MUSE_EVENT_HISTORY_LIMIT=100
MUSE_CAPACITY_REFRESH_SECS=10
MUSE_LIVE_INVALIDATION_BATCH_MS=1000
MUSE_CAPACITY_BACKSTOP_SECS=120
MUSE_CAPACITY_MAX_FRAGMENTS=12
MUSE_CAPACITY_MAX_CONSUMERS=8
MUSE_SHUTDOWN_GRACE_SECS=2
MUSE_METRICS_UPKEEP_SECS=5
MUSE_HTTP_LATENCY_BUCKETS=0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10
MUSE_DASHBOARD_POLICY_JSON='{"utilization":{"warningAt":75,"criticalAt":90},"availability":{"warningBelow":100,"criticalBelow":99},"errorRate":{"warningAt":0.1,"criticalAt":1},"kvCache":{"warningAt":0.7,"criticalAt":0.9},"prefixCache":{"warningBelow":0.7,"criticalBelow":0.4}}'
MUSE_METRICS_REFRESH_SECS=15
MUSE_CHAT_ENABLED=false
MUSE_CHAT_ALLOW_HTTP=false
