# Explicit local-development configuration for `make -C muse run`.
MUSE_HOST=127.0.0.1
MUSE_PORT=8080
MUSE_METRICS_PORT=9090
MUSE_LOG_JSON=false
MUSE_LOG_FILTER=info,muse=debug
MUSE_WORKER_THREAD_STACK_BYTES=67108864
MUSE_LOCAL_CLUSTER_NAME=local
MUSE_LIST_STRATEGY=auto
MUSE_APISERVER_PREFLIGHT_TIMEOUT_SECS=15
MUSE_EVENT_HISTORY_LIMIT=100
MUSE_CAPACITY_REFRESH_SECS=10
MUSE_LIVE_INVALIDATION_BATCH_MS=1000
MUSE_SSE_KEEP_ALIVE_SECS=10
MUSE_CAPACITY_BACKSTOP_SECS=120
MUSE_CAPACITY_MAX_FRAGMENTS=12
MUSE_CAPACITY_MAX_CONSUMERS=8
MUSE_SHUTDOWN_GRACE_SECS=2
MUSE_METRICS_UPKEEP_SECS=5
MUSE_HTTP_LATENCY_BUCKETS=0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10
MUSE_DASHBOARD_POLICY_JSON='{"utilization":{"warningAt":75,"criticalAt":90},"availability":{"warningBelow":100,"criticalBelow":99},"errorRate":{"warningAt":0.1,"criticalAt":1},"kvCache":{"warningAt":0.7,"criticalAt":0.9},"prefixCache":{"warningBelow":0.7,"criticalBelow":0.4}}'
MUSE_METRICS_REFRESH_SECS=15
MUSE_METRICS_QUERY_CONCURRENCY=8
MUSE_METRICS_REQUEST_TIMEOUT_SECS=15
MUSE_CHAT_ENABLED=false
MUSE_CHAT_ALLOW_HTTP=false
MUSE_LOGS_ENABLED=true
# Per-cluster log-stream allowlist; must name configured clusters (here, the
# ambient MUSE_LOCAL_CLUSTER_NAME). Empty would leave the enabled feature dark.
MUSE_LOGS_CLUSTERS=local
MUSE_LOGS_MAX_SESSIONS=16
MUSE_LOGS_MAX_PODS_PER_SESSION=48
MUSE_LOGS_MAX_TAILS_PER_CLUSTER=256
MUSE_LOGS_BUFFER_LINES=512
MUSE_LOGS_LINE_BYTES_MAX=8192
MUSE_LOGS_MAX_LINES_PER_SEC=2000
MUSE_LOGS_TAIL_LINES_MAX=5000
MUSE_LOGS_CATCHUP_LINES=10
MUSE_LOGS_POD_REFRESH_SECS=5
MUSE_LOGS_SESSION_MAX_SECS=3600
MUSE_LOGS_START_STAGGER_MS=25
MUSE_LOGS_NOTICE_INTERVAL_SECS=5
MUSE_LOGS_TAIL_RETRY_BACKOFF_SECS=10
MUSE_LOGS_FLUSH_INTERVAL_MS=200
MUSE_LOGS_BATCH_MAX_LINES=500
MUSE_LOGS_CLIENT_BUFFER_LINES=5000
MUSE_LOGS_MAX_BUFFER_BYTES=134217728
MUSE_LOGS_SINCE_OPTIONS_JSON='{"default":"15m","options":[{"id":"5m","label":"5m","seconds":300},{"id":"15m","label":"15m","seconds":900},{"id":"1h","label":"1h","seconds":3600},{"id":"6h","label":"6h","seconds":21600}]}'
