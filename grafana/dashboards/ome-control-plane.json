            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (slice_type, topology) (ome_tpu_slices{cluster=\"$cluster\",pod=~\"ome-controller-manager.*\",pod=~\"$pod\",state=\"pending\"})) or vector(0)",
              "refId": "B",
              "legendFormat": "pending"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (slice_type, topology) (ome_tpu_slices{cluster=\"$cluster\",pod=~\"ome-controller-manager.*\",pod=~\"$pod\",state=\"terminating\"})) or vector(0)",
              "refId": "C",
              "legendFormat": "terminating"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (slice_type, topology) (ome_tpu_slices{cluster=\"$cluster\",pod=~\"ome-controller-manager.*\",pod=~\"$pod\",state=\"orphaned\"})) or vector(0)",
              "refId": "D",
              "legendFormat": "orphaned"
            }
          ],
          "fieldConfig": {
