            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (slice_type, topology) (ome_tpu_slices{cluster=\"$cluster\",pod=~\"ome-controller-manager.*\",pod=~\"$pod\",state=\"ready\"})) or vector(0)",
              "refId": "A",
              "legendFormat": "ready"
