              "custom": {
                "lineWidth": 2,
                "fillOpacity": 8,
                "showPoints": "never",
                "spanNulls": true,
                "stacking": {
                  "mode": "normal",
                  "group": "A"
                }
              },
              "color": {
                "mode": "palette-classic"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "text",
                    "value": null
                  }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "description": "TPU slices the controller provisioned that exist now. pending includes a slice the provider failed to provision. orphaned means the slice's InferenceReplica is gone, so no reconcile will release it: it holds TPU capacity until deleted by hand. Any orphaned slice is a leak. Only the leader reports; max by (slice_type, topology) collapses the per-pod series so a leader change does not inflate the count.",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
