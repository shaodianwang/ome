{
  "uid": "ome-quota",
  "title": "OME \u00b7 Quota",
  "description": "Accelerator capacity and how the quota tree divides it. Capacity is measured on each workload cluster by its own quota manager; a management plane holds the authored fleet tree and reports no local capacity.",
  "tags": [
    "ome",
    "quota"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"ome_quota_capacity_.*\"}, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values({__name__=~\"ome_quota_capacity_.*\"}, cluster)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "\ud83e\uddee Fleet accelerator capacity",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Allocatable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource, flavor) (ome_quota_capacity_allocatable{cluster=~\"$cluster\",endpoint=\"metrics\"})",
          "refId": "A",
          "legendFormat": "{{resource}} \u00b7 {{flavor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators on nodes that could accept work. Allocatable, not capacity, so it will not reconcile against kube_node_status_capacity.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Unavailable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource, flavor) (ome_quota_capacity_unavailable{cluster=~\"$cluster\",endpoint=\"metrics\"})",
          "refId": "B",
          "legendFormat": "{{resource}} \u00b7 {{flavor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators on nodes that matched a ResourceFlavor but are cordoned or not Ready. Budgets are sized against allocatable, so this is the parked remainder.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Parked",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource, flavor) (ome_quota_capacity_unavailable{cluster=~\"$cluster\",endpoint=\"metrics\"}) / clamp_min(sum by (resource, flavor) (ome_quota_capacity_allocatable{cluster=~\"$cluster\",endpoint=\"metrics\"}) + sum by (resource, flavor) (ome_quota_capacity_unavailable{cluster=~\"$cluster\",endpoint=\"metrics\"}), 1)",
          "refId": "C",
          "legendFormat": "{{resource}} \u00b7 {{flavor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Share of matched accelerators that cannot accept work. clamp_min keeps a cluster with no capacity from dividing by zero.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Unattributed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource) (ome_quota_capacity_unattributed{cluster=~\"$cluster\",endpoint=\"metrics\"}) or vector(0)",
          "refId": "D",
          "legendFormat": "{{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators no ResourceFlavor claims, so they fund no budget at all. Zero is the healthy reading. Non-zero means a missing or ambiguous ResourceFlavor, not a shrinking fleet -- and a budget written against that hardware reports CapacityExceeded with nothing else to say why.\n\nBroken out by resource but not by flavor: an unattributed accelerator is one no flavor claimed, so it has no flavor to report.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Allocatable vs unavailable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource, flavor) (ome_quota_capacity_allocatable{cluster=~\"$cluster\",endpoint=\"metrics\"})",
          "refId": "E",
          "legendFormat": "{{resource}} / {{flavor}} allocatable"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resource, flavor) (ome_quota_capacity_unavailable{cluster=~\"$cluster\",endpoint=\"metrics\"})",
          "refId": "F",
          "legendFormat": "{{resource}} / {{flavor}} unavailable"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Per (resource, flavor), which is the granularity Kueue keys quota by.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Nodes by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (ome_quota_capacity_nodes{cluster=~\"$cluster\",endpoint=\"metrics\"})",
          "refId": "G",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "The node counts behind the accelerator totals. This is what separates a one-machine shortfall from a rack: the same missing accelerators look identical until you can see how many machines they came from.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "\ud83d\udcd0 Distribution",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Governed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ome_quota_budget_nominal{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}) / clamp_min(sum(ome_quota_capacity_allocatable{cluster=~\"$cluster\",endpoint=\"metrics\"}), 1)",
          "refId": "H"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Share of the cluster's allocatable accelerators that any budget covers. Low means most of the fleet is running outside the quota system entirely, which is not visible from any per-tenant number.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Allocated",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ome_quota_budget_nominal{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"})",
          "refId": "I"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators promised to tenants, summed over leaves. Leaves only: a cohort's nominal contains its children's, so counting both would double.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Admitted",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ome_quota_budget_admitted{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"})",
          "refId": "J"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators actually admitted against the materialized queues, including anything borrowed.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Allocation used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 13,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ome_quota_budget_admitted{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}) / clamp_min(sum(ome_quota_budget_nominal{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}), 1)",
          "refId": "K"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Admitted over allocated, across every tenant. This is headroom inside the quota system, which is a different question from how much of the fleet the system governs at all.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Allocated by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_replace(sum by (quota, path) (ome_quota_budget_nominal{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}), \"tenant\", \"$1\", \"quota\", \"(.*)\"), \"tenant\", \"$1\", \"path\", \"(.+)\")",
          "refId": "L",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "How the tree divides the fleet. Stacked, so the top of the stack is everything promised and the bands are who it was promised to.\n\nLabelled by root-to-node path, because a bare object name does not say which parent a tenant hangs off and two tenants under different parents are distinguishable only by their ancestry. A band labelled with a plain name carries no path: either the node is unreachable from the root, or the cluster reporting it predates the path label.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "\ud83d\udcca Tenant utilization",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Utilization by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (quota) (ome_quota_budget_admitted{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}) / clamp_min(sum by (quota) (ome_quota_budget_nominal{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}), 1)",
          "refId": "M",
          "legendFormat": "{{quota}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "description": "Admitted over its own allowance. A tenant walking up to 1 over an hour is the shape this board exists to make visible; above 1 means it is borrowing.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Reserved but not admitted",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (quota) (ome_quota_budget_reserved{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"}) - sum by (quota) (ome_quota_budget_admitted{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"})",
          "refId": "N",
          "legendFormat": "{{quota}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Accelerators a tenant owns but has not started using. Without this a tenant sitting at its ceiling reads as idle, because admitted alone cannot tell 'not running' from 'not entitled'.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Borrowed by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (quota) (ome_quota_budget_borrowed{cluster=~\"$cluster\",endpoint=\"metrics\",plane=\"workload\",role=\"ClusterQueue\"})",
          "refId": "O",
          "legendFormat": "{{quota}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Admitted above a tenant's own nominal, taken from idle siblings and reclaimable on contention. One leaf borrowing its whole cohort is the saturation case that is invisible from any single tenant's numbers.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
