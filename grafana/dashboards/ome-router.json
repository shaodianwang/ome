    {
      "type": "timeseries",
      "title": "Where the time goes (p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(router_request_duration_seconds_bucket{cluster=\"$cluster\",pod=~\"$pod\"}[5m])))",
          "refId": "S",
          "legendFormat": "Total"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(router_ingress_overhead_seconds_bucket{cluster=\"$cluster\",pod=~\"$pod\"}[5m])))",
          "refId": "T",
          "legendFormat": "Router ingress overhead"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(router_egress_to_engine_seconds_bucket{cluster=\"$cluster\",pod=~\"$pod\"}[5m])))",
          "refId": "U",
          "legendFormat": "Egress to engine"
