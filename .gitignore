# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.pyc
*.egg-info/
bin
.venv/
venv/
# Test binary, built with `go test -c`
*.test
.serena
.claude
# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Kubernetes Generated files - skip generated files, except for vendored files
vendor
!vendor/**/zz_generated.*

# Mac file system
**/.DS_Store

# editor and IDE paraphernalia
.idea
.editorconfig
.vscode
.project
*.swp
*.swo
*~
*.iml

# Python dev
.mypy_cache

# Notebook Checkpoints
.ipynb_checkpoints

.gitlab-ci.yml
.openapi-generator-ignore
.openapi-generator/


# Downloaded by hack install
hack/istio-*

# iTerm config
.itermconfig

# Docker config
docker-compose.yml
coverage.cov

# Istio installer downloaded by quick install
istio-*

# Node.js / npm / yarn / pnpm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Next.js
.next/
out/
dist/
build/

# Perf-harness run artifacts (summary.yaml + cmd.stats.yaml per run) are
# local-only, regenerated each run by `make run-perf-*`; never commit them.
artifacts/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Frontend environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.nyc_output/

# Vercel
.vercel

java-client/target
java-client/crd
# Debug binaries from Go debugging
**/__debug_bin*
coverage-*.out
coverage-*.out.tmp
coverage-*.html
*target
*Cargo.lock

# static library
*.a

hack/python-sdk/openapi-generator-cli-*.jar

# Go build cache directories
.cache/

# Vendored CRD YAMLs from go.mod modules — regenerated by `make dep-crds`.
# Single source of truth is go.mod; checking the YAMLs in would create a
# drift surface and bloat the repo (Knative + LWS + KEDA + Ray + Istio
# is ~30 YAMLs). The README in this dir documents the contract.
tests/integration/dep-crds/*/
!tests/integration/dep-crds/README.md
# Envoy Gateway has no Go module distribution we can pull from go.mod
# (the operator is shipped as a binary). CRDs in this bundle are
# hand-authored stubs and stay tracked. See its SOURCE file.
!tests/integration/dep-crds/envoy-gateway/
!tests/integration/dep-crds/envoy-gateway/**
# Prometheus Operator ships Go types in a subpackage of go.mod but the
# CRD YAMLs live in the parent repo (not Go-importable). Hand-vendor
# the PodMonitor CRD stub for envtest. See its SOURCE file.
!tests/integration/dep-crds/prometheus-operator/
!tests/integration/dep-crds/prometheus-operator/**

# OMENative coordination test harness (hack/omenative-testing): per-run results
# are local-only (regenerated each run). The generated isvcs/ test matrix IS
# tracked — only results/ and Python bytecode caches are ignored.
hack/omenative-testing/perm/results/
__pycache__/

# Rollout state-machine review tooling (hack/omenative-testing/statemachine):
# rendered grid JSON, Mermaid, and HTML are regenerated by `make
# rolloutspec-render` and never committed.
hack/omenative-testing/statemachine/out/
